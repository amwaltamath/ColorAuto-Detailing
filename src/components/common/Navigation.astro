---
const currentPath = Astro.url.pathname;
const isAutoService = currentPath.startsWith('/services/auto-detailing') || currentPath.startsWith('/services/auto-paint-correction') || currentPath.startsWith('/services/paint-protection-film') || currentPath.startsWith('/services/ceramic-coating') || currentPath.startsWith('/services/window-tinting') || currentPath.startsWith('/services/color-ppf');
const isHomeService = currentPath.startsWith('/services/home-window-tint') || currentPath.startsWith('/services/office-window-tint');

function navLinkClass(href: string): string {
  const isActive = currentPath === href || currentPath === href + '/';
  return isActive ? 'text-blue-600 font-semibold text-sm transition' : 'text-gray-700 text-sm hover:text-blue-600 transition';
}
function dropdownLinkClass(href: string): string {
  const isActive = currentPath === href || currentPath === href + '/';
  return isActive ? 'block px-4 py-2 text-sm text-blue-600 bg-blue-50 font-semibold' : 'block px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600';
}
function mobileLinkClass(href: string): string {
  const isActive = currentPath === href || currentPath === href + '/';
  return isActive ? 'block py-2 text-sm text-blue-600 font-semibold' : 'block py-2 text-sm text-gray-700 hover:text-blue-600';
}
---

<nav class="bg-white shadow-md sticky top-0 z-50" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-3">
      <img src="/images/ColorAuto.png" alt="ColorAuto Logo" class="h-12 w-auto" />
    </a>
    
    <!-- Navigation -->
    <div class="hidden md:flex space-x-8 items-center">
      
      <!-- Auto Service Dropdown -->
      <div class="relative group">
        <button class:list={[isAutoService ? 'text-blue-600 font-semibold' : 'text-gray-700', 'text-sm hover:text-blue-600 transition flex items-center']}>
          Auto Service
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div class="absolute left-0 mt-0 pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <div class="bg-white rounded-md shadow-lg">
          <div class="py-2">
            <a href="/services/auto-detailing" class={dropdownLinkClass('/services/auto-detailing')}>Auto Detailing</a>
            <a href="/services/auto-paint-correction" class={dropdownLinkClass('/services/auto-paint-correction')}>Auto Paint Correction</a>
            <a href="/services/paint-protection-film" class={dropdownLinkClass('/services/paint-protection-film')}>Paint Protection Film</a>
            <a href="/services/ceramic-coating" class={dropdownLinkClass('/services/ceramic-coating')}>Ceramic Coating</a>
            <a href="/services/window-tinting" class={dropdownLinkClass('/services/window-tinting')}>Window Tinting</a>
            <a href="/services/color-ppf" class={dropdownLinkClass('/services/color-ppf')}>Color PPF</a>
          </div>
          </div>
        </div>
      </div>

      <!-- Home Service Dropdown -->
      <div class="relative group">
        <button class:list={[isHomeService ? 'text-blue-600 font-semibold' : 'text-gray-700', 'text-sm hover:text-blue-600 transition flex items-center']}>
            Home and Office Service
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div class="absolute left-0 mt-0 pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <div class="bg-white rounded-md shadow-lg">
          <div class="py-2">
            <a href="/services/home-window-tint" class={dropdownLinkClass('/services/home-window-tint')}>Home Window Tint</a>
            <a href="/services/office-window-tint" class={dropdownLinkClass('/services/office-window-tint')}>Office Window Tint</a>
          </div>
          </div>
        </div>
      </div>

      <a href="/our-work" class={navLinkClass('/our-work')}>Our Work</a>
      <a href="/our-team" class={navLinkClass('/our-team')}>Our Team</a>
      <a href="/apply" class={navLinkClass('/apply')}>Apply</a>
      <a href="/contact" class={navLinkClass('/contact')}>Contact</a>
    </div>
    
    <!-- Customer Login -->
    <a href="/customer/login" class="hidden md:flex items-center gap-1.5 text-sm text-gray-700 hover:text-blue-600 transition mx-2" aria-label="Customer Login">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
      Login
    </a>
    
    <!-- CTA Button -->
    <a href="tel:970-628-1505" class="bg-blue-600 text-white px-4 py-2 rounded text-sm font-semibold hover:bg-blue-700 transition hidden md:block">
      970-628-1505
    </a>
    
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-button" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden text-gray-700 text-2xl p-2 rounded hover:bg-gray-100" aria-label="Open menu">
      ☰
    </button>
  </div>
  
  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-gray-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-2">
      

      <details class="group" open={isAutoService}>
        <summary class="flex items-center justify-between py-2 text-gray-700 hover:text-blue-600 cursor-pointer">
          <span>Auto Service</span>
          <svg class="w-4 h-4 ml-2 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </summary>
        <div class="pl-4 mt-1 space-y-1">
          <a href="/services/auto-detailing" class={mobileLinkClass('/services/auto-detailing')}>Auto Detailing</a>
          <a href="/services/auto-paint-correction" class={mobileLinkClass('/services/auto-paint-correction')}>Auto Paint Correction</a>
          <a href="/services/paint-protection-film" class={mobileLinkClass('/services/paint-protection-film')}>Paint Protection Film</a>
          <a href="/services/ceramic-coating" class={mobileLinkClass('/services/ceramic-coating')}>Ceramic Coating</a>
          <a href="/services/window-tinting" class={mobileLinkClass('/services/window-tinting')}>Window Tinting</a>
          <a href="/services/color-ppf" class={mobileLinkClass('/services/color-ppf')}>Color PPF</a>
        </div>
      </details>

      <details class="group" open={isHomeService}>
        <summary class="flex items-center justify-between py-2 text-gray-700 hover:text-blue-600 cursor-pointer">
          <span>Home and Office Service</span>
          <svg class="w-4 h-4 ml-2 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </summary>
        <div class="pl-4 mt-1 space-y-1">
          <a href="/services/home-window-tint" class={mobileLinkClass('/services/home-window-tint')}>Home Window Tint</a>
          <a href="/services/office-window-tint" class={mobileLinkClass('/services/office-window-tint')}>Office Window Tint</a>
        </div>
      </details>

      <a href="/our-work" class="block py-2 text-gray-700 hover:text-blue-600 transition">Our Work</a>
      <a href="/our-team" class="block py-2 text-gray-700 hover:text-blue-600 transition">Our Team</a>
      <a href="/apply" class="block py-2 text-gray-700 hover:text-blue-600 transition">Apply</a>
      <a href="/contact" class="block py-2 text-gray-700 hover:text-blue-600 transition">Contact</a>
      <a href="/customer/login" class="block py-2 text-blue-600 font-semibold hover:text-blue-700 transition">Customer Login</a>
      <a href="/employee/login" class="block py-2 text-gray-700 hover:text-blue-600 transition font-semibold">👤 Employee Portal</a>

      <a href="tel:970-628-1505" class="block mt-2 bg-blue-600 text-white text-center px-4 py-2 rounded text-sm font-semibold hover:bg-blue-700 transition">
        Call 970-628-1505
      </a>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const willOpen = menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(willOpen));
    });
  });
  </script>
