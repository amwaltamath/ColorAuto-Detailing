---
import '../styles/global.css';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, keywords, canonical, image, noindex } = Astro.props;
---

<Layout title={title} description={description} keywords={keywords} canonical={canonical} image={image} noindex={noindex} hideChat={true}>
  <!-- Auth guard: redirect to login if no token -->
  <script is:inline>
    if (!localStorage.getItem('authToken')) {
      window.location.replace('/employee/login');
    }
  </script>
  <div class="min-h-screen bg-slate-950">
    <!-- Employee Header -->
    <header class="relative bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 shadow-xl border-b border-slate-700/50">
      <!-- Subtle top accent line -->
      <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-blue-500 via-cyan-400 to-blue-500"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Top bar: branding + actions -->
        <div class="flex justify-between items-center py-3 md:py-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 md:w-10 md:h-10 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-blue-500/20">
              <svg class="w-5 h-5 md:w-6 md:h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </div>
            <div>
              <h1 class="text-lg md:text-xl font-bold text-white tracking-tight">{title}</h1>
              <p class="text-[10px] md:text-xs text-slate-400 font-medium tracking-wide uppercase">Color Auto Detailing</p>
            </div>
          </div>
          <div class="flex items-center gap-2 md:gap-3">
            <span id="user-greeting" class="hidden md:inline-block text-sm text-slate-400"></span>
            <button id="logout-button" class="group flex items-center gap-1.5 bg-slate-700/50 text-slate-300 px-3 py-2 md:px-4 md:py-2 rounded-lg hover:bg-red-600/90 hover:text-white border border-slate-600/50 hover:border-red-500/50 transition-all duration-200 text-xs md:text-sm font-medium">
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
              </svg>
              <span class="hidden sm:inline">Logout</span>
            </button>
          </div>
        </div>

        <!-- Navigation pills -->
        <nav class="flex gap-1.5 md:gap-2 overflow-x-auto pb-3 -mb-px scrollbar-hide" aria-label="Employee navigation">
          <button class="nav-pill" data-tab="leads">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            <span>Leads</span>
          </button>
          <button class="nav-pill" data-tab="schedules">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            <span>Schedules</span>
          </button>
          <button class="nav-pill" data-tab="teams">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
            <span>Team</span>
          </button>
          <button class="nav-pill" data-tab="messages">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>
            <span>Messages</span>
          </button>
          <button class="nav-pill" data-tab="chat">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" /></svg>
            <span>Chat</span>
          </button>
          <button class="nav-pill" data-tab="analytics">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            <span>Analytics</span>
          </button>
          <button class="nav-pill" data-tab="profile">
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span>Profile</span>
          </button>
        </nav>
      </div>
    </header>
    
    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
      <slot />
    </main>
  </div>
</Layout>

<script is:inline>
  // Logout handler
  const logoutBtn = document.getElementById('logout-button');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      try {
        localStorage.removeItem('authToken');
      } catch (e) {
        console.error('Failed to clear auth token', e);
      }
      window.location.href = '/employee/login';
    });
  }

  // User greeting
  try {
    const greetEl = document.getElementById('user-greeting');
    const token = localStorage.getItem('authToken');
    if (greetEl && token) {
      const hour = new Date().getHours();
      const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
      greetEl.textContent = greeting;
    }
  } catch (e) {}

  // Tab navigation pills
  const navPills = Array.from(document.querySelectorAll('.nav-pill'));
  navPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const tab = pill.getAttribute('data-tab');
      if (window.switchTab && typeof window.switchTab === 'function') {
        window.switchTab(tab);
        
        // Update nav pills active state
        navPills.forEach(p => p.classList.remove('nav-pill--active'));
        pill.classList.add('nav-pill--active');
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        window.location.href = `/employee/dashboard#${tab}`;
      }
    });
  });

  // Sync nav pills with active tab on load
  document.addEventListener('DOMContentLoaded', () => {
    const activeTab = localStorage.getItem('activeTab') || 'leads';
    const activePill = document.querySelector(`.nav-pill[data-tab="${activeTab}"]`);
    if (activePill) {
      navPills.forEach(p => p.classList.remove('nav-pill--active'));
      activePill.classList.add('nav-pill--active');
    }
  });
</script>

<style>
  /* Hide scrollbar for nav overflow */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background-color: transparent;
    color: rgb(148 163 184); /* slate-400 */
    white-space: nowrap;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .nav-pill:hover {
    background-color: rgb(30 41 59 / 0.8); /* slate-800/80 */
    color: rgb(226 232 240); /* slate-200 */
  }
  .nav-pill--active {
    background-color: rgb(30 58 138 / 0.5); /* blue-900/50 */
    border-color: rgb(59 130 246 / 0.5); /* blue-500/50 */
    color: rgb(96 165 250); /* blue-400 */
    box-shadow: 0 0 12px rgb(59 130 246 / 0.15);
  }
  .nav-pill:focus {
    outline: none;
  }
  .nav-pill:focus-visible {
    outline: 2px solid rgb(59 130 246);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .nav-pill {
      font-size: 0.8125rem;
      padding: 0.5rem 1rem;
      gap: 0.5rem;
    }
  }
</style>
