<script is:inline>
  // Logout handler
  var logoutBtn = document.getElementById('logout-button');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', function() {
      try {
        localStorage.removeItem('authToken');
        localStorage.removeItem('userRole');
      } catch (e) {
        console.error('Failed to clear auth token', e);
      }
      window.location.href = '/employee/login';
    });
  }

  // User greeting
  try {
    var greetEl = document.getElementById('user-greeting');
    var token = localStorage.getItem('authToken');
    if (greetEl && token) {
      var hour = new Date().getHours();
      var greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
      greetEl.textContent = greeting;
    }
  } catch (e) {}

  // Sync active state for all nav items (mobile pills + desktop sidebar)
  function syncNav(activeTab, activeCrmView) {
    document.querySelectorAll('[data-tab]').forEach(function(item) {
      var tab = item.getAttribute('data-tab');
      var crmView = item.getAttribute('data-crm-view');
      var isActive;
      if (crmView) {
        isActive = tab === 'crm' && crmView === activeCrmView;
      } else {
        isActive = tab === activeTab;
      }
      if (item.classList.contains('nav-pill')) {
        item.classList.toggle('nav-pill--active', isActive);
      } else if (item.classList.contains('sidebar-item')) {
        item.classList.toggle('sidebar-item--active', isActive);
      }
    });
  }

  // Handle clicks on all nav items
  document.querySelectorAll('[data-tab]').forEach(function(item) {
    item.addEventListener('click', function() {
      var tab = item.getAttribute('data-tab');
      var crmView = item.getAttribute('data-crm-view');
      if (crmView) {
        try { localStorage.setItem('activeCrmView', crmView); } catch(e) {}
        window.dispatchEvent(new CustomEvent('crm:navigate', { detail: { view: crmView } }));
      }
      if (window.switchTab && typeof window.switchTab === 'function') {
        window.switchTab(tab);
        syncNav(tab, crmView || (function() { try { return localStorage.getItem('activeCrmView') || 'customers'; } catch(e) { return 'customers'; } })());
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        window.location.href = '/employee/dashboard#' + tab;
      }
    });
  });

  // Restore active state on load
  document.addEventListener('DOMContentLoaded', function() {
    try {
      var activeTab = localStorage.getItem('activeTab') || 'leads';
      var activeCrmView = localStorage.getItem('activeCrmView') || 'customers';
      syncNav(activeTab, activeCrmView);
    } catch (e) {}
  });
</script>

