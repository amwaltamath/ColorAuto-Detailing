      <aside class="hidden md:flex flex-col w-56 flex-shrink-0 bg-white border-r border-gray-200 overflow-y-auto">
        <nav class="flex flex-col p-3 pt-4 gap-0.5">

          <!-- Operations -->
          <button class="sidebar-item" data-tab="leads">
