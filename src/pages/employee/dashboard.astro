---
import EmployeeLayout from '../../layouts/EmployeeLayout.astro';
import { ChatManager } from '../../components/features/ChatManager';
import { SchedulesTable } from '../../components/employee/SchedulesTable';
import { TeamsTable } from '../../components/employee/TeamsTable';
import { ProfileSettings } from '../../components/employee/ProfileSettings';
import { DashboardStats } from '../../components/employee/DashboardStats';
import { AnalyticsDashboard } from '../../components/employee/AnalyticsDashboard';
import { LeadsTable } from '../../components/employee/LeadsTable';
import { ReportsDashboard } from '../../components/employee/ReportsDashboard';
---

<EmployeeLayout title="Employee Dashboard">
  <div class="space-y-6">
    
    <!-- Quick Stats -->
    <DashboardStats client:load />

    <!-- Tab Content -->
    <div id="leads" class="tab-content active">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-blue-500/10 text-blue-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Lead Management</h2>
        </div>
        <LeadsTable client:load />
      </div>
    </div>

    <div id="schedules" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-emerald-500/10 text-emerald-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Service Schedules</h2>
        </div>
        <div class="overflow-x-auto">
          <SchedulesTable client:load />
        </div>
      </div>
    </div>

    <div id="teams" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-purple-500/10 text-purple-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Your Teams</h2>
        </div>
        <div class="overflow-x-auto">
          <TeamsTable client:load />
        </div>
      </div>
    </div>

    <div id="messages" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-amber-500/10 text-amber-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Team Messages</h2>
        </div>
        <div class="flex flex-col items-center justify-center py-12 text-center">
          <div class="w-12 h-12 rounded-full bg-slate-700/50 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>
          </div>
          <p class="text-slate-400 text-sm font-medium">Team messaging coming soon</p>
          <p class="text-slate-500 text-xs mt-1">Stay tuned for real-time team communication</p>
        </div>
      </div>
    </div>

    <div id="chat" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-cyan-500/10 text-cyan-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Customer Chat Support</h2>
        </div>
        <div class="overflow-x-auto">
          <ChatManager client:load />
        </div>
      </div>
    </div>

    <div id="analytics" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-indigo-500/10 text-indigo-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Website Analytics</h2>
        </div>
        <AnalyticsDashboard client:load />
      </div>
    </div>

    <div id="reports" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-rose-500/10 text-rose-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Weekly Reports</h2>
        </div>
        <ReportsDashboard client:load />
      </div>
    </div>

    <div id="profile" class="tab-content hidden">
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <div class="dashboard-card-icon bg-slate-500/10 text-slate-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h2 class="text-lg md:text-xl font-semibold text-white">Profile Settings</h2>
        </div>
        <ProfileSettings client:load />
      </div>
    </div>

  </div>
</EmployeeLayout>

<script>
  // Make switchTab available globally
  window.switchTab = function(tabName: string) {
    // Hide all tabs
    document.querySelectorAll('.tab-content').forEach(tab => {
      tab.classList.add('hidden');
      tab.classList.remove('active');
    });

    // Show selected tab with animation
    const selectedTab = document.getElementById(tabName);
    if (selectedTab) {
      selectedTab.classList.remove('hidden');
      // Trigger reflow for animation
      void selectedTab.offsetWidth;
      selectedTab.classList.add('active');
    }

    // Sync nav pills in header
    document.querySelectorAll('.nav-pill').forEach(pill => {
      pill.classList.remove('nav-pill--active');
      if (pill.getAttribute('data-tab') === tabName) {
        pill.classList.add('nav-pill--active');
      }
    });

    // Store preference
    localStorage.setItem('activeTab', tabName);
  };

  // Restore last active tab on page load
  document.addEventListener('DOMContentLoaded', function() {
    const lastTab = localStorage.getItem('activeTab') || 'leads';
    window.switchTab(lastTab);
  });
</script>

<style>
  .dashboard-card {
    background: linear-gradient(to bottom, rgb(30 41 59), rgb(30 41 59 / 0.8));
    border: 1px solid rgb(51 65 85 / 0.8);
    border-radius: 0.75rem;
    padding: 1.25rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.2), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
  @media (min-width: 768px) {
    .dashboard-card {
      padding: 1.75rem;
    }
  }

  .dashboard-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(51 65 85 / 0.6);
  }

  .dashboard-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .tab-content {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  
  .tab-content.active {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }
  
  .tab-content.hidden {
    display: none;
    visibility: hidden;
  }
</style>
