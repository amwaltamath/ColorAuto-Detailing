---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
---

<PublicLayout
  title="Auto Window Tinting Grand Junction, CO | XPEL Ceramic Tint | ColorAuto"
  description="Professional auto window tinting in Grand Junction, CO. XPEL PRIME ceramic tint blocks 99% of UV rays and up to 90% of solar heat. Colorado law compliant. Get a free quote!"
  keywords={[
    'auto window tinting Grand Junction',
    'car window tinting Grand Junction CO',
    'automotive window tint Grand Junction',
    'ceramic window tint Grand Junction',
    'XPEL window tint Grand Junction',
    'car tinting near me',
    'window tint for cars',
    'UV protection window tint',
    'heat rejection window tint',
    'Colorado car window tint law'
  ]}
  image="/images/primexr.jpg"
  canonical="https://colorautodetailing.com/services/auto-window-tinting"
>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/services' },
    { label: 'Window Tinting', href: '/services/window-tinting' },
    { label: 'Auto Window Tinting' }
  ]} />

  <!-- Hero Section -->
  <section class="relative text-white overflow-hidden" style="padding-top: 5rem; padding-bottom: 5rem;">
    <div class="absolute inset-0">
      <img
        src="/images/primexr.jpg"
        alt="Professional auto window tinting on a vehicle in Grand Junction, CO"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/60 to-black/40"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <p class="text-amber-400 font-semibold text-sm uppercase tracking-widest mb-3">Grand Junction, CO</p>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight mb-6">
          Auto Window Tinting
        </h1>
        <p class="text-lg md:text-xl text-gray-200 mb-8">
          Protect your car, stay cooler, and look great. XPEL PRIME ceramic films with 99% UV block, lifetime warranty, and Colorado-law-compliant installation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/contact"
            class="inline-block bg-amber-400 text-black font-bold py-4 px-8 rounded-lg hover:bg-amber-300 transition shadow-lg text-center text-lg"
          >
            Get a Free Quote
          </a>
          <a
            href="tel:970-628-1505"
            class="inline-block bg-white/10 border-2 border-white text-white font-bold py-4 px-8 rounded-lg hover:bg-white/20 transition text-center text-lg"
          >
            Call 970-628-1505
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-gray-900 text-white py-4">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-sm font-semibold">
        <div class="flex items-center justify-center gap-2">
          <span class="text-amber-400 text-lg">✓</span> Lifetime Warranty
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-amber-400 text-lg">✓</span> Colorado Law Compliant
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-amber-400 text-lg">✓</span> Certified Installers
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-amber-400 text-lg">✓</span> XPEL Authorized Dealer
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits + Quote Box -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <!-- Left: Benefits -->
        <div>
          <h2 class="text-3xl font-bold mb-6">Why Tint Your Car Windows?</h2>
          <p class="text-lg text-gray-600 mb-8">
            Grand Junction summers are brutal on your vehicle's interior. Our XPEL PRIME ceramic films go far beyond looks—they protect you, your passengers, and your investment.
          </p>
          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <span class="mt-1 w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm shrink-0">UV</span>
              <div>
                <strong class="text-gray-900">Blocks 99% of UV Rays</strong>
                <p class="text-gray-600 text-sm mt-1">Shields your skin from UVA/UVB radiation and prevents dashboard, seats, and trim from fading or cracking.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="mt-1 w-8 h-8 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-sm shrink-0">🌡</span>
              <div>
                <strong class="text-gray-900">Up to 90% Solar Heat Rejection</strong>
                <p class="text-gray-600 text-sm mt-1">Keeps your car significantly cooler—reducing AC workload and improving fuel efficiency.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="mt-1 w-8 h-8 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center font-bold text-sm shrink-0">👁</span>
              <div>
                <strong class="text-gray-900">Glare Reduction</strong>
                <p class="text-gray-600 text-sm mt-1">Reduces eye strain from blinding sun and oncoming headlights for safer, more comfortable driving.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="mt-1 w-8 h-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center font-bold text-sm shrink-0">🔒</span>
              <div>
                <strong class="text-gray-900">Privacy & Security</strong>
                <p class="text-gray-600 text-sm mt-1">Darker shades reduce visibility into your vehicle and the film holds shattered glass together in an accident.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="mt-1 w-8 h-8 rounded-full bg-yellow-100 text-yellow-600 flex items-center justify-center font-bold text-sm shrink-0">💎</span>
              <div>
                <strong class="text-gray-900">Enhanced Appearance</strong>
                <p class="text-gray-600 text-sm mt-1">A clean, professional tint job elevates the look of any vehicle and adds resale value.</p>
              </div>
            </li>
          </ul>

          <!-- Colorado Law Notice -->
          <div class="mt-8 bg-blue-50 border-l-4 border-blue-500 p-5 rounded-r-lg">
            <h3 class="font-bold text-blue-800 mb-1">Colorado Tint Law</h3>
            <p class="text-sm text-blue-700">
              Front side windows must allow more than <strong>27% VLT</strong> (visible light transmission). Rear side and rear windows have no restriction. We ensure every installation is fully compliant.
            </p>
          </div>
        </div>

        <!-- Right: Quote Box + Shade Guide -->
        <div class="space-y-6">
          <div class="bg-gray-900 text-white p-8 rounded-2xl shadow-xl">
            <h3 class="text-2xl font-bold mb-2">Ready to Tint Your Car?</h3>
            <p class="text-gray-300 mb-6">Get a personalized quote—we'll recommend the best film for your vehicle and budget.</p>
            <a
              href="/contact"
              class="block w-full bg-amber-400 text-black text-center font-bold py-4 rounded-lg hover:bg-amber-300 transition text-lg mb-3"
            >
              Get a Free Quote
            </a>
            <a
              href="tel:970-628-1505"
              class="block w-full border-2 border-white text-white text-center font-bold py-4 rounded-lg hover:bg-white/10 transition"
            >
              Call 970-628-1505
            </a>
            <p class="text-gray-400 text-xs text-center mt-4">Free estimates · No obligation · Same-week appointments available</p>
          </div>

          <!-- Shade Guide -->
          <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200">
            <h4 class="font-bold text-lg mb-4">Tint Shade Guide (VLT %)</h4>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-14 h-7 rounded border border-gray-300 bg-gray-100 shrink-0"></div>
                <span class="text-sm font-medium">70% — Nearly clear, maximum light</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-14 h-7 rounded border border-gray-300 bg-gray-300 shrink-0"></div>
                <span class="text-sm font-medium">50% — Light tint, subtle look</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-14 h-7 rounded border border-gray-300 bg-gray-400 shrink-0"></div>
                <span class="text-sm font-medium">35% — Medium tint, popular choice</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-14 h-7 rounded border border-gray-300 bg-gray-600 shrink-0"></div>
                <span class="text-sm font-medium">20% — Dark tint, high privacy</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-14 h-7 rounded border border-gray-300 bg-gray-900 shrink-0"></div>
                <span class="text-sm font-medium">5% — Limo tint, maximum privacy</span>
              </div>
            </div>
            <p class="text-xs text-gray-500 mt-3">* Colorado law requires front side windows at 27% VLT or higher</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- XPEL Film Options -->
  <section class="bg-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-white mb-3">Choose Your XPEL PRIME Film</h2>
        <p class="text-gray-300 text-lg">From solid everyday protection to the absolute best ceramic performance</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- PRIME CS -->
        <div class="group relative rounded-2xl overflow-hidden shadow-2xl bg-black">
          <img
            src="/images/primecs.jpg"
            alt="XPEL PRIME CS color-stable dyed window tint film for cars"
            class="w-full h-80 object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-0 flex flex-col justify-end items-center text-center px-6 pb-8 text-white">
            <h3 class="text-2xl font-bold mb-2">PRIME CS</h3>
            <p class="text-sm text-gray-300 leading-relaxed mb-3">Best-in-class color-stable dyed film · 99% UV block · Moderate heat rejection · Lifetime warranty</p>
            <div class="text-3xl font-extrabold text-amber-300 mb-4">From $250</div>
            <a href="/contact" class="bg-white text-black font-bold py-2 px-6 rounded-lg hover:bg-gray-100 transition text-sm">Get a Quote</a>
          </div>
        </div>

        <!-- PRIME XR -->
        <div class="group relative rounded-2xl overflow-hidden shadow-2xl bg-black">
          <div class="absolute top-4 left-1/2 -translate-x-1/2 z-10 bg-amber-400 text-black px-4 py-1.5 rounded-full text-xs font-bold shadow-lg">MOST POPULAR</div>
          <img
            src="/images/primexr.jpg"
            alt="XPEL PRIME XR nano-ceramic window tint film for cars"
            class="w-full h-80 object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-0 flex flex-col justify-end items-center text-center px-6 pb-8 text-white">
            <h3 class="text-2xl font-bold mb-2">PRIME XR</h3>
            <p class="text-sm text-gray-300 leading-relaxed mb-3">Nano-ceramic technology · 60% heat reduction · Crystal-clear optics · Signal-friendly (no GPS interference)</p>
            <div class="text-3xl font-extrabold text-amber-300 mb-4">From $350</div>
            <a href="/contact" class="bg-amber-400 text-black font-bold py-2 px-6 rounded-lg hover:bg-amber-300 transition text-sm">Get a Quote</a>
          </div>
        </div>

        <!-- PRIME XR PLUS -->
        <div class="group relative rounded-2xl overflow-hidden shadow-2xl bg-black">
          <div class="absolute top-4 left-1/2 -translate-x-1/2 z-10 bg-white text-black px-4 py-1.5 rounded-full text-xs font-bold shadow-lg">BEST PERFORMANCE</div>
          <img
            src="/images/primexrplus.jpg"
            alt="XPEL PRIME XR PLUS flagship ceramic auto window tint film"
            class="w-full h-80 object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-0 flex flex-col justify-end items-center text-center px-6 pb-8 text-white">
            <h3 class="text-2xl font-bold mb-2">PRIME XR PLUS</h3>
            <p class="text-sm text-gray-300 leading-relaxed mb-3">Flagship ceramic film · 60% heat rejection · Feels 3–8°F cooler · Maximum clarity and durability</p>
            <div class="text-3xl font-extrabold text-amber-300 mb-4">From $500</div>
            <a href="/contact" class="bg-white text-black font-bold py-2 px-6 rounded-lg hover:bg-gray-100 transition text-sm">Get a Quote</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Vehicle Types -->
  <section class="bg-white py-14">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-4">We Tint All Vehicle Types</h2>
      <p class="text-center text-gray-600 mb-10">From daily drivers to exotics—every vehicle gets the same expert installation.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { label: 'Sedans & Coupes', icon: '🚗' },
          { label: 'SUVs & Crossovers', icon: '🚙' },
          { label: 'Trucks & Vans', icon: '🛻' },
          { label: 'Luxury & Exotic', icon: '🏎' },
        ].map(v => (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 text-center">
            <div class="text-3xl mb-2">{v.icon}</div>
            <p class="font-semibold text-gray-800">{v.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-5">

        <details class="bg-white border border-gray-200 rounded-xl p-5 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            How long does auto window tinting take?
            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-gray-600 mt-3 text-sm leading-relaxed">
            Most standard vehicles take 2–4 hours. Larger vehicles or those with more complex window shapes may take up to 6 hours. We'll give you a time estimate when you book.
          </p>
        </details>

        <details class="bg-white border border-gray-200 rounded-xl p-5 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            How long do I need to wait before rolling down my windows?
            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-gray-600 mt-3 text-sm leading-relaxed">
            We recommend waiting <strong>3–5 days</strong> before rolling your windows down to allow the film to fully cure and adhere. This is especially important in cooler weather.
          </p>
        </details>

        <details class="bg-white border border-gray-200 rounded-xl p-5 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            Is window tinting legal in Colorado?
            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-gray-600 mt-3 text-sm leading-relaxed">
            Yes. Colorado law requires front side windows to transmit more than 27% of visible light. Rear side windows and the rear window have no restriction. All of our installations are fully compliant.
          </p>
        </details>

        <details class="bg-white border border-gray-200 rounded-xl p-5 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            What's the difference between dyed and ceramic tint?
            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-gray-600 mt-3 text-sm leading-relaxed">
            Dyed tint (like PRIME CS) primarily blocks visible light for privacy and some UV protection. Ceramic tint (like PRIME XR and XR PLUS) uses nano-ceramic particles to block significantly more infrared heat while maintaining crystal-clear visibility. Ceramic tint is also signal-friendly and more durable.
          </p>
        </details>

        <details class="bg-white border border-gray-200 rounded-xl p-5 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            Does ceramic tint interfere with GPS or cell signals?
            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-gray-600 mt-3 text-sm leading-relaxed">
            No. XPEL PRIME XR and XR PLUS are non-metallic ceramic films, which means they are fully signal-friendly. Your GPS, cell service, and radio won't be affected.
          </p>
        </details>

        <details class="bg-white border border-gray-200 rounded-xl p-5 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            What warranty do you offer on window tint?
            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-gray-600 mt-3 text-sm leading-relaxed">
            All XPEL PRIME films come with a <strong>lifetime warranty</strong> against fading, bubbling, peeling, and delaminating. We also stand behind our installation work.
          </p>
        </details>

      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-gradient-to-r from-blue-700 to-blue-900 py-14">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to Tint Your Car?</h2>
      <p class="text-blue-100 text-lg mb-8">
        Book your appointment today and experience the ColorAuto difference—premium XPEL film, certified installers, lifetime warranty.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-block bg-amber-400 text-black font-bold py-4 px-10 rounded-lg hover:bg-amber-300 transition shadow-lg text-lg"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:970-628-1505"
          class="inline-block border-2 border-white text-white font-bold py-4 px-10 rounded-lg hover:bg-white/10 transition text-lg"
        >
          Call 970-628-1505
        </a>
      </div>
    </div>
  </section>

  <!-- Location Strip -->
  <section class="bg-white border-t border-gray-200 py-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div>
          <h3 class="font-bold text-lg mb-1">📍 Location</h3>
          <p class="text-gray-600 text-sm">562 S Westgate Drive, Grand Junction, CO 81505</p>
          <a href="https://maps.app.goo.gl/U8GewAAibaMwEZ8q8" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-semibold hover:underline text-sm">Get Directions</a>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-1">☎️ Phone</h3>
          <a href="tel:970-628-1505" class="text-blue-600 font-semibold hover:underline">970-628-1505</a>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-1">📧 Email</h3>
          <a href="mailto:admin@colorautodetailing.com" class="text-blue-600 font-semibold hover:underline text-sm">admin@colorautodetailing.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-8">Complete Vehicle Protection</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
        <a href="/services/window-tinting" class="bg-white p-5 rounded-xl shadow hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold mb-1 text-blue-600">All Window Tinting</h3>
          <p class="text-gray-600 text-sm">Auto, home & office tinting</p>
        </a>
        <a href="/services/paint-protection-film" class="bg-white p-5 rounded-xl shadow hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold mb-1 text-blue-600">Paint Protection Film</h3>
          <p class="text-gray-600 text-sm">Shield your paint from damage</p>
        </a>
        <a href="/services/ceramic-coating" class="bg-white p-5 rounded-xl shadow hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold mb-1 text-blue-600">Ceramic Coating</h3>
          <p class="text-gray-600 text-sm">Long-lasting paint protection</p>
        </a>
        <a href="/services/auto-detailing" class="bg-white p-5 rounded-xl shadow hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold mb-1 text-blue-600">Auto Detailing</h3>
          <p class="text-gray-600 text-sm">Interior & exterior care</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        name: "Auto Window Tinting",
        serviceType: "AutomotiveWindowTinting",
        description: "Professional automotive window tinting in Grand Junction, CO. XPEL PRIME ceramic films block 99% of UV rays and up to 90% of solar heat. Lifetime warranty.",
        url: "https://colorautodetailing.com/services/auto-window-tinting",
        image: "https://colorautodetailing.com/images/primexr.jpg",
        provider: {
          "@type": "AutoRepair",
          name: "ColorAuto Detailing",
          telephone: "970-628-1505",
          url: "https://colorautodetailing.com",
          address: {
            "@type": "PostalAddress",
            streetAddress: "562 S Westgate Drive",
            addressLocality: "Grand Junction",
            addressRegion: "CO",
            postalCode: "81505",
            addressCountry: "US"
          }
        },
        areaServed: {
          "@type": "City",
          name: "Grand Junction",
          sameAs: "https://en.wikipedia.org/wiki/Grand_Junction,_Colorado"
        },
        offers: [
          {
            "@type": "Offer",
            name: "XPEL PRIME CS Window Tint",
            price: "250",
            priceCurrency: "USD",
            description: "Color-stable dyed film with 99% UV protection and lifetime warranty"
          },
          {
            "@type": "Offer",
            name: "XPEL PRIME XR Window Tint",
            price: "350",
            priceCurrency: "USD",
            description: "Nano-ceramic film with 60% heat rejection, signal-friendly"
          },
          {
            "@type": "Offer",
            name: "XPEL PRIME XR PLUS Window Tint",
            price: "500",
            priceCurrency: "USD",
            description: "Flagship ceramic film with maximum heat rejection and clarity"
          }
        ],
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: "5.0",
          reviewCount: "72",
          bestRating: "5",
          worstRating: "1"
        }
      },
      {
        "@type": "FAQPage",
        mainEntity: [
          {
            "@type": "Question",
            name: "How long does auto window tinting take?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Most standard vehicles take 2–4 hours. Larger vehicles may take up to 6 hours."
            }
          },
