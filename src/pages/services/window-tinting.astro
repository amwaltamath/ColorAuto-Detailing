---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
---

<PublicLayout
  title="Grand Junction Window Tinting | Automotive, Home & Office | ColorAuto"
  description="#1 Grand Junction window tinting for cars, homes, and offices. Professional installation, UV protection, heat reduction, and privacy. Lifetime warranty. Get a free quote!"
  keywords={[
    'Grand Junction window tinting',
    'window tinting Grand Junction',
    'car window tint',
    'home window tint',
    'office window tint',
    'UV protection',
    'privacy tint',
    'XPEL PRIME',
    'tint installer Grand Junction'
  ]}
  image="/images/primexr.jpg"
>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/services' },
    { label: 'Window Tinting' }
  ]} />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/primexr.jpg" alt="Professional automotive window tinting in Grand Junction, CO" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Grand Junction Window Tinting</h1>
      <p class="text-xl text-gray-200 drop-shadow-md">Automotive, home, and office window tinting by certified local experts</p>
    </div>
  </section>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Left Column -->
      <div>
        <h2 class="text-3xl font-bold mb-6">Why Choose Our Grand Junction Window Tinting?</h2>
        <p class="text-lg text-gray-700 mb-6">
          Window tinting provides more than just a sleek appearance. Our premium films offer UV protection, heat reduction, glare elimination, and enhanced privacy for your vehicle, home, or office.
        </p>

        <h3 class="text-2xl font-bold mb-4 text-blue-600">Key Benefits</h3>
        <ul class="space-y-4 mb-8">
          <li class="flex items-start">
            <span class="text-blue-600 font-bold text-xl mr-3">✓</span>
            <div>
              <strong class="text-lg">UV Protection</strong>
              <p class="text-gray-600">Blocks up to 99% of harmful UV rays that cause skin damage and interior fading</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold text-xl mr-3">✓</span>
            <div>
              <strong class="text-lg">Heat Reduction</strong>
              <p class="text-gray-600">Rejects up to 90% of solar heat, keeping interiors cooler</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold text-xl mr-3">✓</span>
            <div>
              <strong class="text-lg">Glare Reduction</strong>
              <p class="text-gray-600">Reduces eye strain from bright sunlight and headlights</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold text-xl mr-3">✓</span>
            <div>
              <strong class="text-lg">Privacy & Security</strong>
              <p class="text-gray-600">Enhanced privacy and shatter resistance in case of accidents</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold text-xl mr-3">✓</span>
            <div>
              <strong class="text-lg">Interior Protection</strong>
              <p class="text-gray-600">Prevents fading and cracking of upholstery, dashboard, and trim</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="text-blue-600 font-bold text-xl mr-3">✓</span>
            <div>
              <strong class="text-lg">Lifetime Warranty</strong>
              <p class="text-gray-600">Backed by manufacturer warranty against fading, peeling, and bubbling</p>
            </div>
          </li>
        </ul>

        <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4">
          <p class="text-sm text-gray-700">
            <strong>Colorado Law:</strong> Front side windows must allow more than 27% of light in. We ensure all installations are compliant with state regulations.
          </p>
        </div>
      </div>

      <!-- Right Column -->
      <div>
        <div class="bg-gray-200 rounded-lg h-96 mb-6 flex items-center justify-center">
          <img src="/images/window tint.jpg" alt="XPEL window tint installation on vehicle side windows" class="w-full h-full object-cover rounded-lg" loading="lazy" />
        </div>

        <div class="bg-white p-8 rounded-lg shadow-lg">
          <h3 class="text-2xl font-bold mb-2">Book Window Tinting</h3>
          <p class="text-gray-600 mb-6">
            Send us your vehicle details and preferred tint, and we’ll reply with a quote and scheduling options.
          </p>

          <form id="window-tint-booking-form" class="space-y-4">
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="source" value="website" />
            <input type="hidden" name="service" value="Window Tinting" />
            <input type="hidden" name="landing_page" value="/services/window-tinting" />

            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="booking-name">Name</label>
              <input id="booking-name" name="name" type="text" required class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500" placeholder="Your name" />
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="booking-email">Email</label>
              <input id="booking-email" name="email" type="email" required class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500" placeholder="you@example.com" />
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="booking-phone">Phone</label>
              <input id="booking-phone" name="phone" type="tel" class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500" placeholder="(970) 123-4567" />
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="booking-vehicle">Vehicle</label>
              <input id="booking-vehicle" name="vehicle" type="text" class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500" placeholder="Year, Make, Model" />
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2" for="booking-message">Details</label>
              <textarea id="booking-message" name="message" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500" placeholder="Tell us what tint shade you want and when you’d like to book."></textarea>
            </div>

            <div id="booking-status" class="text-sm font-semibold hidden"></div>

            <button type="submit" class="block w-full bg-blue-600 text-white text-center font-bold py-3 rounded hover:bg-blue-700 transition">
              Request Booking
            </button>
            <a href="tel:970-628-1505" class="block w-full bg-gray-800 text-white text-center font-bold py-3 rounded hover:bg-gray-900 transition">
              Call: 970-628-1505
            </a>
            <p class="text-xs text-gray-400 text-center mt-2">
              By submitting, you agree to our <a href="/privacy-policy" class="underline hover:text-gray-600">Privacy Policy</a>.
            </p>
          </form>
        </div>

        <div class="mt-8 bg-gray-50 p-6 rounded-lg">
          <h4 class="font-bold text-lg mb-3">Tint Shade Options</h4>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span>70%</span>
              <div class="w-20 h-6 bg-gray-200 rounded"></div>
            </div>
            <div class="flex justify-between items-center">
              <span>55% (Light Tint)</span>
              <div class="w-20 h-6 bg-gray-300 rounded"></div>
            </div>
            <div class="flex justify-between items-center">
              <span>45% (Medium Tint)</span>
              <div class="w-20 h-6 bg-gray-400 rounded"></div>
            </div>
            <div class="flex justify-between items-center">
              <span>30</span>
              <div class="w-20 h-6 bg-gray-500 rounded"></div>
            </div>
            <div class="flex justify-between items-center">
              <span>20% (Dark Tint)</span>
              <div class="w-20 h-6 bg-gray-600 rounded"></div>
            </div>
            <div class="flex justify-between items-center">
              <span>15</span>
              <div class="w-20 h-6 bg-gray-700 rounded"></div>
            </div>
            <div class="flex justify-between items-center">
              <span>5% (Limo Tint)</span>
              <div class="w-20 h-6 bg-gray-900 rounded"></div>
            </div>
          </div>
          <p class="text-sm text-gray-600 mt-3">Lower percentages = darker tint</p>
        </div>
      </div>
    </div>
  </div>

  <!-- XPEL Film Options -->
  <section class="bg-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-4xl font-bold text-white mb-3">Choose Your XPEL PRIME Film</h2>
        <p class="text-gray-300 text-lg">From great everyday protection to the absolute best heat-blocking performance</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- PRIME CS -->
        <div class="group relative rounded-2xl overflow-hidden shadow-2xl bg-black">
          <img src="/images/primecs.jpg" alt="XPEL PRIME CS color-stable window tint film" class="w-full h-96 object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-0 flex flex-col justify-end items-center text-center px-6 pb-8 text-white">
            <h3 class="text-2xl font-bold mb-3 drop-shadow">PRIME CS</h3>
            <p class="text-sm text-gray-200 leading-relaxed">Best color-stable dyed film on the market · 99% UV protection · Moderate heat rejection · Lifetime warranty</p>
            <div class="text-3xl font-extrabold text-amber-300 mt-4">From $250</div>
          </div>
        </div>

        <!-- PRIME XR -->
        <div class="group relative rounded-2xl overflow-hidden shadow-2xl bg-black">
          <div class="absolute top-4 left-1/2 -translate-x-1/2 z-10 bg-amber-400 text-black px-4 py-2 rounded-full text-xs font-bold shadow-lg">MOST POPULAR</div>
          <img src="/images/primexr.jpg" alt="XPEL PRIME XR nano-ceramic window tint film" class="w-full h-96 object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-0 flex flex-col justify-end items-center text-center px-6 pb-8 text-white">
            <h3 class="text-2xl font-bold mb-3 drop-shadow">PRIME XR</h3>
            <p class="text-sm text-gray-200 leading-relaxed">Premium nano-ceramic performance · 60% heat reduction · Crystal clear optics · Signal-friendly</p>
            <div class="text-3xl font-extrabold text-amber-300 mt-4">From $350</div>
          </div>
        </div>

        <!-- PRIME XR PLUS -->
        <div class="group relative rounded-2xl overflow-hidden shadow-2xl bg-black">
          <img src="/images/primexrplus.jpg" alt="XPEL PRIME XR PLUS flagship ceramic window tint film" class="w-full h-96 object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-0 flex flex-col justify-end items-center text-center px-6 pb-8 text-white">
            <h3 class="text-2xl font-bold mb-3 drop-shadow">PRIME XR PLUS</h3>
            <p class="text-sm text-gray-200 leading-relaxed">Flagship film—absolute best · 60% heat reduction · Feels 3–8°F cooler inside · Maximum clarity & durability</p>
            <div class="text-3xl font-extrabold text-amber-300 mt-4">From $500</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services for Home & Office -->
  <section class="bg-gray-100 py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-4">Window Film for Every Application</h2>
      <p class="text-center text-gray-600 mb-8">We also provide professional window tinting for homes and offices</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow text-center">
            <h3 class="text-xl font-bold mb-2 text-blue-600">Automotive</h3>
            <p class="text-gray-600">Cars, trucks, SUVs, and commercial vehicles</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow text-center">
            <h3 class="text-xl font-bold mb-2 text-blue-600">Home</h3>
            <p class="text-gray-600">Home windows for energy savings and privacy</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow text-center">
            <h3 class="text-xl font-bold mb-2 text-blue-600">Office</h3>
            <p class="text-gray-600">Office buildings and storefronts</p>
          </div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="bg-white border-t border-b border-gray-200 py-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <h3 class="text-lg font-bold mb-2">📍 Location</h3>
          <p class="text-gray-600">Grand Junction, CO</p>
          <a
            href="https://maps.app.goo.gl/U8GewAAibaMwEZ8q8"
            target="_blank"
            class="text-blue-600 font-semibold hover:underline text-sm"
          >
            Get Directions
          </a>
        </div>
        <div class="text-center">
          <h3 class="text-lg font-bold mb-2">☎️ Phone</h3>
          <a href="tel:970-628-1505" class="text-blue-600 font-semibold hover:underline">
            970-628-1505
          </a>
        </div>
        <div class="text-center">
          <h3 class="text-lg font-bold mb-2">📧 Email</h3>
          <a href="mailto:admin@colorautodetailing.com" class="text-blue-600 font-semibold hover:underline text-sm">
            admin@colorautodetailing.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-width CTA Banner -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Tint Your Windows Today</h2>
      <p class="text-blue-100 text-lg mb-8">Expert window tinting with premium XPEL film — heat rejection, UV protection, and privacy.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#window-tint-booking-form" class="inline-block bg-white text-blue-700 font-bold py-3 px-8 rounded-lg hover:bg-blue-50 transition shadow-lg">Book Online</a>
        <a href="tel:970-628-1505" class="inline-block border-2 border-white text-white font-bold py-3 px-8 rounded-lg hover:bg-white/10 transition">Call 970-628-1505</a>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="bg-white py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">Complete Vehicle Protection</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/paint-protection-film" class="bg-gray-50 p-6 rounded-lg shadow hover:shadow-lg transition text-center">
          <h3 class="text-xl font-bold mb-2 text-blue-600">Paint Protection Film</h3>
          <p class="text-gray-600">Shield your paint from damage</p>
        </a>
        <a href="/services/ceramic-coating" class="bg-gray-50 p-6 rounded-lg shadow hover:shadow-lg transition text-center">
          <h3 class="text-xl font-bold mb-2 text-blue-600">Ceramic Coating</h3>
          <p class="text-gray-600">Long-lasting paint protection</p>
        </a>
        <a href="/services/auto-detailing" class="bg-gray-50 p-6 rounded-lg shadow hover:shadow-lg transition text-center">
          <h3 class="text-xl font-bold mb-2 text-blue-600">Auto Detailing</h3>
          <p class="text-gray-600">Complete interior and exterior care</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.querySelector('#window-tint-booking-form');
      const statusEl = document.querySelector('#booking-status');

      if (!form || !statusEl) return;

      const setStatus = (text, color) => {
        statusEl.textContent = text;
        statusEl.classList.remove('hidden', 'text-red-600', 'text-green-600', 'text-gray-700');
        statusEl.classList.add(color);
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        setStatus('Sending...', 'text-gray-700');

        try {
          const formData = new FormData(form);
          const res = await fetch('/api/contact', {
            method: 'POST',
            body: formData,
          });

          const json = await res.json().catch(() => ({}));

          if (res.ok && json.ok) {
            setStatus('Thanks! We received your booking request.', 'text-green-600');
            form.reset();
          } else {
            setStatus(json.error || 'Unable to send right now. Please call 970-628-1505.', 'text-red-600');
          }
        } catch (error) {
          setStatus('Unable to send right now. Please call 970-628-1505.', 'text-red-600');
        }
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Window Tinting",
    serviceType: "AutoDetailing",
    description: "#1 Grand Junction window tinting for cars, homes, and offices. Professional installation, UV protection, heat reduction, and privacy. Lifetime warranty.",
    url: "https://colorautodetailing.com/services/window-tinting",
    provider: {
      "@type": "AutoRepair",
      name: "ColorAuto Detailing",
      telephone: "970-628-1505",
      address: {
        "@type": "PostalAddress",
        streetAddress: "562 S Westgate Drive",
        addressLocality: "Grand Junction",
        addressRegion: "CO",
        postalCode: "81505",
        addressCountry: "US"
      }
    },
    areaServed: {
      "@type": "City",
      name: "Grand Junction"
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "5.0",
      reviewCount: "72",
      bestRating: "5",
      worstRating: "1"
    }
  })} />
</PublicLayout>
