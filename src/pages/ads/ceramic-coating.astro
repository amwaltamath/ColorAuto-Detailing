---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const title = "Ceramic Coating | Protect Your Paint | ColorAuto Detailing";
const description = "Professional ceramic coating in Grand Junction. Long-lasting paint protection, hydrophobic coating, 4-year coverage packages. Book now!";
const keywords = ['ceramic coating', 'paint protection', 'hydrophobic coating', 'Grand Junction'];
---

<Layout {title} {description} {keywords} noindex={true}>
  <QuoteModal client:load isOpen={false} service="Ceramic Coating" source="google_ads" />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/ceramic-coating.jpg" alt="Ceramic Coating" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Ceramic Coating Protection</h1>
      <p class="text-2xl text-gray-200 drop-shadow-md mb-8">Paint Protection That Lasts Years</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition shadow-lg inline-block">
          Call Now: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-lg inline-block cursor-pointer border-0">
          Get Free Quote
        </button>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-6 md:gap-10 text-sm text-gray-600">
      <div class="flex items-center gap-2"><span class="text-yellow-500 text-lg">★★★★★</span><span class="font-semibold">4.9/5</span> Google Reviews</div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Certified Installers</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Same-Week Availability</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Warranty Backed</span></div>
    </div>
  </section>

  <!-- Quick Benefits -->
  <section class="bg-gradient-to-b from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-extrabold text-center mb-12">Why Ceramic Coating?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🛡️</div>
          <h3 class="font-extrabold text-2xl mb-3">4-Year Protection</h3>
          <p class="text-blue-100 leading-relaxed">Long-lasting defense against UV, dirt, and oxidation</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">💧</div>
          <h3 class="font-extrabold text-2xl mb-3">Hydrophobic Finish</h3>
          <p class="text-blue-100 leading-relaxed">Water beads and rolls off for easy cleaning</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">✨</div>
          <h3 class="font-extrabold text-2xl mb-3">Showroom Shine</h3>
          <p class="text-blue-100 leading-relaxed">Professional gloss that turns heads</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">What You Get</h2>
      <ul class="space-y-3">
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Professional application by certified installers</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>4-year manufacturer warranty coverage</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Superior UV and oxidation protection</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Enhanced water beading and dirt resistance</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Reduced washing and maintenance time</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Application Process -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Professional Application Process</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">1</div>
          <h3 class="font-bold text-xl mb-2">Paint Prep</h3>
          <p class="text-gray-600">Thorough wash, clay bar, and decontamination</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">2</div>
          <h3 class="font-bold text-xl mb-2">Paint Correction</h3>
          <p class="text-gray-600">Remove swirls and imperfections for perfect bonding</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">3</div>
          <h3 class="font-bold text-xl mb-2">Coating Application</h3>
          <p class="text-gray-600">Precision application in controlled environment</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">4</div>
          <h3 class="font-bold text-xl mb-2">Curing</h3>
          <p class="text-gray-600">24-48 hour cure time for maximum hardness</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Coating Packages -->
  <section class="bg-gradient-to-b from-gray-100 to-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Ceramic Coating Packages</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Level 1</h3>
          <p class="text-3xl font-bold text-blue-600 mb-2">4-Year</p>
          <p class="text-gray-600 mb-6">Professional protection</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Paint decontamination</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Single-layer coating</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>4-year warranty</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Enhanced gloss</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-blue-600 hover:border-blue-700 transition transform scale-105">
          <div class="bg-blue-600 text-white text-sm font-bold py-1 px-3 rounded-full inline-block mb-4">POPULAR</div>
          <h3 class="text-2xl font-bold mb-4">Level 2</h3>
          <p class="text-3xl font-bold text-blue-600 mb-2">4-Year</p>
          <p class="text-gray-600 mb-6">Complete protection</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Everything in Level 1</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Paint correction included</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Multi-layer coating</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>4-year warranty</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Wheel coating included</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Protection Comparison -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Ceramic Coating vs. Traditional Wax</h2>
      <p class="text-xl text-gray-600 text-center mb-12">See why ceramic coating is the superior choice</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="relative overflow-hidden rounded-lg shadow-xl">
          <img src="/images/protection.jpg" alt="Protected paint" class="w-full h-80 object-cover" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
            <h3 class="text-white font-bold text-2xl mb-2">Ceramic Coating</h3>
            <ul class="text-white space-y-1">
              <li>✓ Lasts 4+ years</li>
              <li>✓ Chemical resistant</li>
              <li>✓ Superior gloss</li>
              <li>✓ Self-cleaning effect</li>
            </ul>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-lg shadow-xl opacity-75">
          <img src="/images/autodetailing.jpg" alt="Waxed paint" class="w-full h-80 object-cover" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
            <h3 class="text-white font-bold text-2xl mb-2">Traditional Wax</h3>
            <ul class="text-white space-y-1">
              <li>• Lasts 2-3 months</li>
              <li>• Washes away easily</li>
              <li>• Limited protection</li>
              <li>• Frequent reapplication</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Customer Reviews</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"The ceramic coating has been amazing! Water literally rolls right off. My car stays cleaner longer and the shine is incredible."</p>
          <p class="font-bold">- David M.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Best investment for my new car. The paint looks wet even when dry. Professional installation and great customer service."</p>
          <p class="font-bold">- Jennifer L.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Two years later and still looks like the day it was applied. Worth every penny for the long-term protection."</p>
          <p class="font-bold">- Robert S.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4" id="faq-list">
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How long does ceramic coating last?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Our ceramic coatings provide 4+ years of durable protection. With proper maintenance, many customers see results lasting even longer. We offer both single-layer and multi-layer packages.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Is ceramic coating worth the investment?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Absolutely. Ceramic coating eliminates the need for regular waxing, makes washing easier, and preserves your vehicle's resale value. It pays for itself in time saved and paint protection.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How long does the application take?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            The full process typically takes 1-2 days, including paint prep, correction (if needed), coating application, and curing time. We'll give you an exact timeline when you book.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Can ceramic coating be applied to any vehicle?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Yes! We coat cars, trucks, SUVs, and even boats and RVs. New or used, any vehicle benefits from ceramic protection. We recommend paint correction first for older vehicles.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-white border-t-4 border-blue-600 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Protect Your Paint Today</h2>
      <p class="text-xl text-gray-600 mb-8">Expert ceramic coating application with warranty protection</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          ☎️ Call: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition border-0 cursor-pointer">
          📧 Get Free Quote
        </button>
      </div>
      <p class="text-sm text-gray-500 mt-6">📍 562 S. Westgate Drive, Grand Junction, CO</p>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="sticky-cta-bar" id="stickyCta">
    <a href="tel:970-628-1505" class="bg-white text-blue-700">📞 Call Now</a>
    <button data-quote-popup class="bg-green-500 text-white">💬 Free Quote</button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('openQuoteModal'));
        });
      });
      // Sticky CTA bar - show after scrolling past hero
      const bar = document.getElementById('stickyCta');
      if (bar) {
        window.addEventListener('scroll', () => {
          bar.classList.toggle('visible', window.scrollY > 600);
        }, { passive: true });
      }
      // FAQ accordion
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('span:last-child');
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-toggle span:last-child').forEach(s => s.textContent = '+');
          if (!isOpen) { answer.classList.add('open'); icon.textContent = '−'; }
        });
      });
    });
  </script>
</Layout>
