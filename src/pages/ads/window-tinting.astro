---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is window tinting legal in Colorado?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Colorado allows 27% VLT on front side windows, and any darkness on rear and back windows. ColorAuto Detailing ensures every install meets Colorado state regulations."
      }
    },
    {
      "@type": "Question",
      "name": "How much does window tinting cost in Grand Junction, CO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Window tinting at ColorAuto Detailing starts from $250 for carbon film (Prime CS), $350 for ceramic film (Prime XR), and $500 for premium ceramic (Prime XR Plus). All packages include lifetime warranty."
      }
    },
    {
      "@type": "Question",
      "name": "How long does window tinting take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most vehicles take 1.5–3 hours depending on the number of windows and film type. You can drop off in the morning and pick up the same day."
      }
    },
    {
      "@type": "Question",
      "name": "Will window tint interfere with my electronics?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Our ceramic and carbon films are non-metallic, so they won't interfere with GPS, cell signals, radio, or toll transponders."
      }
    },
    {
      "@type": "Question",
      "name": "Does window tint come with a warranty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All premium films installed by ColorAuto Detailing come with a manufacturer's lifetime warranty covering bubbling, peeling, cracking, and color fading."
      }
    }
  ]
};

const title = "Window Tinting Grand Junction CO | Ceramic & Carbon Tint | ColorAuto Detailing";
const description = "Professional window tinting in Grand Junction, CO. Ceramic & carbon film starting from $250. Lifetime warranty, same-week scheduling. Call 970-628-1505.";
const keywords = ['window tinting Grand Junction', 'car window tint', 'ceramic window tint', 'auto window tinting', 'window tint near me', 'UV protection tint', 'heat rejection film', 'Grand Junction CO tint'];
---

<Layout {title} {description} {keywords} noindex={true} hideChat={true}>
