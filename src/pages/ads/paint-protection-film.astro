---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const title = "Paint Protection Film (PPF) | Grand Junction | ColorAuto Detailing";
const description = "Invisible paint protection film shields your car from damage. Professional PPF installation, self-healing coating, 10-year warranty film.";
const keywords = ['paint protection film', 'PPF', 'paint protection', 'Grand Junction'];
---

<Layout {title} {description} {keywords} noindex={true}>
  <QuoteModal client:load isOpen={false} service="Paint Protection Film" source="google_ads" />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/Paint protection film hero.jpg" alt="Paint Protection Film" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Paint Protection Film</h1>
      <p class="text-2xl text-gray-200 drop-shadow-md mb-8">Invisible Armor for Your Paint</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition shadow-lg inline-block">
          Call Now: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-lg inline-block cursor-pointer border-0">
          Get Free Quote
        </button>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-6 md:gap-10 text-sm text-gray-600">
      <div class="flex items-center gap-2"><span class="text-yellow-500 text-lg">★★★★★</span><span class="font-semibold">4.9/5</span> Google Reviews</div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Certified Installers</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Same-Week Availability</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Warranty Backed</span></div>
    </div>
  </section>

  <!-- Quick Benefits -->
  <section class="bg-gradient-to-b from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-extrabold text-center mb-12">Protect Your Investment</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🛡️</div>
          <h3 class="font-extrabold text-2xl mb-3">Self-Healing</h3>
          <p class="text-blue-100 leading-relaxed">Minor scratches disappear in the sun</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">💎</div>
          <h3 class="font-extrabold text-2xl mb-3">Crystal Clear</h3>
          <p class="text-blue-100 leading-relaxed">Invisible protection, original color shows through</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">⏱️</div>
          <h3 class="font-extrabold text-2xl mb-3">10-Year Warranty Film</h3>
          <p class="text-blue-100 leading-relaxed">Backed by manufacturer 10-year coverage</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Protected -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">PPF Protects Against</h2>
      <ul class="space-y-3">
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Road debris and rock chips</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Bug splatter and tar</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>UV rays and oxidation</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Chemical stains and etching</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Minor scratches and swirl marks</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Coverage Packages -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">PPF Coverage Options</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-gray-200 hover:border-blue-500 transition">
          <img src="/images/Partialfront.jpg" alt="Partial Front Coverage" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Partial Front</h3>
            <p class="text-sm font-semibold text-gray-500 mb-3">Popular starter coverage</p>
            <ul class="space-y-2 text-sm">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Hood (partial)</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Front bumper</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Headlights</span>
              </li>
            </ul>
            <button data-quote-popup class="w-full mt-6 bg-blue-600 text-white py-2 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-blue-600 hover:border-blue-700 transition transform scale-105">
          <div class="bg-blue-600 text-white text-xs font-bold py-1 px-3 text-center">POPULAR</div>
          <img src="/images/fullfront.jpg" alt="Full Front Coverage" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Full Front</h3>
            <p class="text-sm font-semibold text-gray-500 mb-3">Most common daily-driver choice</p>
            <ul class="space-y-2 text-sm">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Full hood</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Full fenders</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Bumper & mirrors</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Headlights</span>
              </li>
            </ul>
            <button data-quote-popup class="w-full mt-6 bg-blue-600 text-white py-2 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-gray-200 hover:border-blue-500 transition">
          <img src="/images/driverspackage.jpg" alt="Drivers Package" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Drivers Package</h3>
            <p class="text-sm font-semibold text-gray-500 mb-3">Expanded protection for high-mileage use</p>
            <ul class="space-y-2 text-sm">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Full front coverage</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>A-pillars & roof</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Rocker panels</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Door edges</span>
              </li>
            </ul>
            <button data-quote-popup class="w-full mt-6 bg-blue-600 text-white py-2 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-gray-200 hover:border-blue-500 transition">
          <img src="/images/full.jpg" alt="Full Coverage" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Full Coverage</h3>
            <p class="text-sm font-semibold text-gray-500 mb-3">Maximum coverage for long-term ownership</p>
            <ul class="space-y-2 text-sm">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Entire vehicle</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Maximum protection</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>10-year film warranty</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">✓</span>
                <span>Paint preservation</span>
              </li>
            </ul>
            <button data-quote-popup class="w-full mt-6 bg-blue-600 text-white py-2 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Installation Process -->
  <section class="bg-gradient-to-b from-gray-100 to-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Professional Installation Process</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">1</div>
          <h3 class="font-bold text-xl mb-2">Surface Prep</h3>
          <p class="text-gray-600">Deep clean and decontamination of all surfaces</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">2</div>
          <h3 class="font-bold text-xl mb-2">Precision Cut</h3>
          <p class="text-gray-600">Computer-cut film for perfect fit on your vehicle</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">3</div>
          <h3 class="font-bold text-xl mb-2">Expert Install</h3>
          <p class="text-gray-600">Bubble-free application by certified technicians</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">4</div>
          <h3 class="font-bold text-xl mb-2">Quality Check</h3>
          <p class="text-gray-600">Final inspection and 48-hour curing period</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why PPF Section -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Protect Your Paint Investment</h2>
      <p class="text-xl text-gray-600 text-center mb-12">PPF is the ultimate defense against daily driving hazards</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="relative overflow-hidden rounded-lg shadow-xl">
          <img src="/images/Paint Protection Film.jpg" alt="Protected vehicle" class="w-full h-80 object-cover" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
            <h3 class="text-white font-bold text-2xl mb-2">Self-Healing Technology</h3>
            <p class="text-white">Minor scratches disappear with heat from the sun or warm water</p>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-lg shadow-xl">
          <img src="/images/protection.jpg" alt="Long-term protection" class="w-full h-80 object-cover" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
            <h3 class="text-white font-bold text-2xl mb-2">Maintain Resale Value</h3>
            <p class="text-white">Keep your paint pristine and your vehicle value high</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Customer Reviews</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Best decision I made for my new truck. The PPF has already saved my paint from several rock chips. You can't even tell it's there!"</p>
          <p class="font-bold">- Mark B.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"The self-healing feature is amazing. A shopping cart scratch completely disappeared in the sun. Professional installation, worth every penny."</p>
          <p class="font-bold">- Lisa H.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"ColorAuto did an excellent job on my BMW. The film is completely invisible and the warranty gives me peace of mind."</p>
          <p class="font-bold">- Chris P.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4" id="faq-list">
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            What is paint protection film (PPF)?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            PPF is a clear, thermoplastic urethane film applied to painted surfaces. It absorbs impacts from rock chips, scratches, and road debris while remaining virtually invisible.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How does the self-healing feature work?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            The film's top coat is heat-activated. Minor scratches and swirl marks disappear when exposed to sunlight or warm water, keeping the surface looking new.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Can PPF be removed without damaging paint?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Yes. Professional-grade PPF is designed to be removable. When properly removed, it leaves your factory paint in pristine condition underneath.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How long does PPF last?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Our premium films come with a 10-year manufacturer warranty. With proper care, the film can protect your vehicle for a decade or more.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-white border-t-4 border-blue-600 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Invest in Paint Protection</h2>
      <p class="text-xl text-gray-600 mb-8">Professional PPF installation with 10-year warranty film</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          ☎️ Call: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition border-0 cursor-pointer">
          📧 Get Free Quote
        </button>
      </div>
      <p class="text-sm text-gray-500 mt-6">📍 562 S. Westgate Drive, Grand Junction, CO</p>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="sticky-cta-bar" id="stickyCta">
    <a href="tel:970-628-1505" class="bg-white text-blue-700">📞 Call Now</a>
    <button data-quote-popup class="bg-green-500 text-white">💬 Free Quote</button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('openQuoteModal'));
        });
      });
      const bar = document.getElementById('stickyCta');
      if (bar) {
        window.addEventListener('scroll', () => {
          bar.classList.toggle('visible', window.scrollY > 600);
        }, { passive: true });
      }
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('span:last-child');
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-toggle span:last-child').forEach(s => s.textContent = '+');
          if (!isOpen) { answer.classList.add('open'); icon.textContent = '−'; }
        });
      });
    });
  </script>
</Layout>
