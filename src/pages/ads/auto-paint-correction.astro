---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const title = "Auto Paint Correction | Remove Swirl Marks | ColorAuto Detailing";
const description = "Professional paint correction removes swirl marks, scratches, and oxidation. Restore showroom shine to your vehicle. Expert paint detailing.";
const keywords = ['paint correction', 'swirl mark removal', 'paint restoration', 'Grand Junction'];
---

<Layout {title} {description} {keywords} noindex={true} hideChat={true} pixelContentName="Paint Correction">
  <QuoteModal client:load isOpen={false} service="Auto Paint Correction" source="google_ads" />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/paintcorrection Paul.JPG" alt="Paint Correction" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Auto Paint Correction</h1>
      <p class="text-2xl text-gray-200 drop-shadow-md mb-8">Restore Your Paint to Showroom Quality</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition shadow-lg inline-block">
          Call Now: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-lg inline-block cursor-pointer border-0">
          Get Free Quote
        </button>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-6 md:gap-10 text-sm text-gray-600">
      <div class="flex items-center gap-2"><span class="text-yellow-500 text-lg">★★★★★</span><span class="font-semibold">4.9/5</span> Google Reviews</div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Certified Installers</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Same-Week Availability</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Warranty Backed</span></div>
    </div>
  </section>

  <!-- Quick Benefits -->
  <section class="bg-gradient-to-b from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-extrabold text-center mb-12">What We Fix</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">✨</div>
          <h3 class="font-extrabold text-2xl mb-3">Swirl Marks Gone</h3>
          <p class="text-blue-100 leading-relaxed">Remove fine scratches and buffer trails</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🛡️</div>
          <h3 class="font-extrabold text-2xl mb-3">Oxidation Removed</h3>
          <p class="text-blue-100 leading-relaxed">Restore dull, faded paint</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🎨</div>
          <h3 class="font-extrabold text-2xl mb-3">Showroom Finish</h3>
          <p class="text-blue-100 leading-relaxed">Mirror-like shine and clarity</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Correct -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">Paint Problems We Solve</h2>
      <ul class="space-y-3">
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Swirl marks and spider webbing from car washes</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Light to moderate surface scratches</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Water spots and mineral etching</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Oxidation and paint dullness</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Buffer trails from improper polishing</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Correction Levels -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Paint Correction Levels</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Stage 1</h3>
          <p class="text-gray-600 mb-6">Single-step correction for light defects</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Removes 50-60% of defects</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Light swirl marks</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Minor oxidation</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Enhanced gloss</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-blue-600 hover:border-blue-700 transition transform scale-105">
          <div class="bg-blue-600 text-white text-sm font-bold py-1 px-3 rounded-full inline-block mb-4">POPULAR</div>
          <h3 class="text-2xl font-bold mb-4">Stage 2</h3>
          <p class="text-gray-600 mb-6">Multi-step correction for moderate defects</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Removes 85-90% of defects</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Moderate swirls & scratches</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Water spot removal</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Deep gloss restoration</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Stage 3</h3>
          <p class="text-gray-600 mb-6">Maximum correction for severe defects</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Removes 95%+ of defects</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Heavy scratches & swirls</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Severe oxidation</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Mirror-like finish</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Correction Process -->
  <section class="bg-gradient-to-b from-gray-100 to-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Our Correction Process</h2>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">1</div>
          <h3 class="font-bold text-xl mb-2">Wash & Decon</h3>
          <p class="text-gray-600 text-sm">Deep clean and clay bar treatment</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">2</div>
          <h3 class="font-bold text-xl mb-2">Paint Inspection</h3>
          <p class="text-gray-600 text-sm">Assess defects with special lighting</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">3</div>
          <h3 class="font-bold text-xl mb-2">Compounding</h3>
          <p class="text-gray-600 text-sm">Remove scratches and defects</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">4</div>
          <h3 class="font-bold text-xl mb-2">Polishing</h3>
          <p class="text-gray-600 text-sm">Refine finish to mirror shine</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">5</div>
          <h3 class="font-bold text-xl mb-2">Protection</h3>
          <p class="text-gray-600 text-sm">Seal with wax or ceramic coating</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Statement -->
  <section class="bg-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-4">
      <h2 class="text-4xl font-bold">Results You Can See</h2>
      <p class="text-xl text-gray-600">Every correction includes a final inspection under proper lighting so you leave with verified clarity and gloss.</p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Customer Reviews</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"I couldn't believe the transformation! All the swirl marks from years of automatic car washes are completely gone. Looks brand new!"</p>
          <p class="font-bold">- Brian D.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"The paint correction brought my black car back to life. The depth and clarity are amazing. True professionals!"</p>
          <p class="font-bold">- Michelle P.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Best money I've spent on my car. The paint looks better than when I bought it new. Highly recommend ColorAuto!"</p>
          <p class="font-bold">- Steve M.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4" id="faq-list">
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            What is paint correction?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            Paint correction is a multi-step process of machine polishing to remove surface defects like swirl marks, scratches, water spots, and oxidation from your vehicle's clear coat.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Will paint correction damage my clear coat?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            No. We use paint depth gauges and start with the least aggressive methods first. Our trained technicians remove only the minimum amount of clear coat needed to eliminate defects.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How long do paint correction results last?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            The correction itself is permanent—those defects are removed for good. To maintain the results, we recommend ceramic coating or PPF after correction, plus proper wash techniques.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Which stage of correction do I need?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            It depends on your paint's condition. Stage 1 handles light swirls, Stage 2 tackles moderate defects, and Stage 3 is for heavily neglected paint. We'll assess and recommend during your consultation.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-white border-t-4 border-blue-600 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Transform Your Paint Today</h2>
      <p class="text-xl text-gray-600 mb-8">Professional paint correction by expert technicians</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          ☎️ Call: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition border-0 cursor-pointer">
          📧 Get Free Quote
        </button>
      </div>
      <p class="text-sm text-gray-500 mt-6">📍 562 S. Westgate Drive, Grand Junction, CO</p>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="sticky-cta-bar" id="stickyCta">
    <a href="tel:970-628-1505" class="bg-white text-blue-700">📞 Call Now</a>
    <button data-quote-popup class="bg-green-500 text-white">💬 Free Quote</button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('openQuoteModal'));
        });
      });
      const bar = document.getElementById('stickyCta');
      if (bar) {
        window.addEventListener('scroll', () => {
          bar.classList.toggle('visible', window.scrollY > 600);
        }, { passive: true });
      }
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('span:last-child');
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-toggle span:last-child').forEach(s => s.textContent = '+');
          if (!isOpen) { answer.classList.add('open'); icon.textContent = '−'; }
        });
      });
    });
  </script>
</Layout>
