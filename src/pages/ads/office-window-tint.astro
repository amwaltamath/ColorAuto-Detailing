---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const title = "Office Window Tinting | Commercial Tint | ColorAuto Detailing";
const description = "Professional office window tinting in Grand Junction. Energy savings, employee comfort, privacy. Commercial window film installation.";
const keywords = ['office window tinting', 'commercial window tint', 'business energy savings', 'Grand Junction'];
---

<Layout {title} {description} {keywords} noindex={true}>
  <QuoteModal client:load isOpen={false} service="Office Window Tinting" source="google_ads" />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/officewindowtint.jpg" alt="Office Window Tint" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Office Window Tinting</h1>
      <p class="text-2xl text-gray-200 drop-shadow-md mb-8">Comfort, Privacy & Energy Savings</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition shadow-lg inline-block">
          Call Now: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-lg inline-block cursor-pointer border-0">
          Get Free Quote
        </button>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-6 md:gap-10 text-sm text-gray-600">
      <div class="flex items-center gap-2"><span class="text-yellow-500 text-lg">★★★★★</span><span class="font-semibold">4.9/5</span> Google Reviews</div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Certified Installers</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Same-Week Availability</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Warranty Backed</span></div>
    </div>
  </section>

  <!-- Quick Benefits -->
  <section class="bg-gradient-to-b from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-extrabold text-center mb-12">Office Window Tinting Benefits</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">💰</div>
          <h3 class="font-extrabold text-2xl mb-3">Lower Operating Costs</h3>
          <p class="text-blue-100 leading-relaxed">Reduce HVAC expenses significantly</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">😊</div>
          <h3 class="font-extrabold text-2xl mb-3">Employee Comfort</h3>
          <p class="text-blue-100 leading-relaxed">Reduce heat and glare for productivity</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🏢</div>
          <h3 class="font-extrabold text-2xl mb-3">Professional Look</h3>
          <p class="text-blue-100 leading-relaxed">Enhance building aesthetics and privacy</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Office Benefits -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">Why Office Window Tinting?</h2>
      <ul class="space-y-3">
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Reduces HVAC costs by up to 30%</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Improves employee comfort and productivity</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Reduces glare on computer screens</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Increases privacy and security</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Tax benefits on energy-efficient upgrades</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Commercial Film Options -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Commercial Film Solutions</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Energy Efficiency</h3>
          <p class="text-gray-600 mb-6">Reduce operating costs</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Up to 80% solar heat rejection</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Lower HVAC demand</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Tax credit eligible</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Quick ROI</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-blue-600 hover:border-blue-700 transition transform scale-105">
          <div class="bg-blue-600 text-white text-sm font-bold py-1 px-3 rounded-full inline-block mb-4">POPULAR</div>
          <h3 class="text-2xl font-bold mb-4">Glare Reduction</h3>
          <p class="text-gray-600 mb-6">Improve productivity</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Reduces screen glare</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Comfortable workspace</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Maintains natural light</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Increased productivity</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Security Film</h3>
          <p class="text-gray-600 mb-6">Protect your business</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Shatter-resistant</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Break-in deterrent</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Bomb blast protection</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Insurance savings</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="bg-gradient-to-b from-gray-100 to-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Commercial Return on Investment</h2>
      <p class="text-xl text-gray-600 text-center mb-12">Window tinting pays for itself in energy savings</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img src="/images/flatwindowtint.jpg" alt="Commercial window tinting" class="rounded-lg shadow-xl" />
        </div>
        <div>
          <h3 class="text-2xl font-bold mb-6">Average Office Building Savings</h3>
          <div class="space-y-4">
            <div class="bg-white p-6 rounded-lg shadow">
              <p class="text-gray-600 mb-2">Annual Energy Savings</p>
              <p class="text-3xl font-bold text-green-600">25-35%</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow">
              <p class="text-gray-600 mb-2">Productivity Improvement</p>
              <p class="text-3xl font-bold text-green-600">Up to 15%</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow">
              <p class="text-gray-600 mb-2">Typical ROI Period</p>
              <p class="text-3xl font-bold text-blue-600">2-5 Years</p>
            </div>
            <div class="bg-blue-50 p-4 rounded-lg">
              <p class="text-sm text-gray-600">ℹ️ May qualify for energy efficiency tax credits and utility rebates</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Benefits -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Why Businesses Choose Window Tinting</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-blue-50 to-white rounded-lg p-8 shadow-lg">
          <h3 class="text-2xl font-bold mb-6 text-blue-600">📈 Operational Benefits</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Reduced HVAC maintenance</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Extended equipment lifespan</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Lower carbon footprint</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Professional appearance</span>
            </li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-white rounded-lg p-8 shadow-lg">
          <h3 class="text-2xl font-bold mb-6 text-green-600">👥 Employee Benefits</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Improved comfort levels</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Reduced eye strain</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Better concentration</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Increased satisfaction</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">What Business Owners Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Our energy costs dropped significantly after installing window tint. The staff is much more comfortable and productive. Excellent ROI!"</p>
          <p class="font-bold">- Mike T., Office Manager</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"No more complaints about glare on computer screens. Professional installation with minimal disruption to our operations."</p>
          <p class="font-bold">- Susan L., Business Owner</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"The building looks more professional and our AC isn't constantly running. Best upgrade we've made this year!"</p>
          <p class="font-bold">- David R., Property Manager</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4" id="faq-list">
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Will window film disrupt our business operations?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            No. Our installation team works around your schedule. We can install during off-hours or weekends. Most office installations are completed in a single day with no downtime.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Does commercial window tinting qualify for tax credits?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            In many cases, yes. Energy-efficient improvements like commercial window film may qualify for federal and state tax incentives. Consult your tax advisor for specific eligibility.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How much can a business save on energy costs?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Commercial buildings typically see 25-35% reduction in energy costs. The ROI usually pays for itself within 2-5 years, depending on building size and sun exposure.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            What types of commercial buildings do you service?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            We service all types: offices, retail storefronts, medical facilities, restaurants, warehouses, and more. We'll assess your building's specific needs and recommend the right film.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-white border-t-4 border-blue-600 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Reduce Operating Costs Today</h2>
      <p class="text-xl text-gray-600 mb-8">Professional office window tinting for commercial spaces</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          ☎️ Call: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition border-0 cursor-pointer">
          📧 Get Free Quote
        </button>
      </div>
      <p class="text-sm text-gray-500 mt-6">📍 562 S. Westgate Drive, Grand Junction, CO</p>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="sticky-cta-bar" id="stickyCta">
    <a href="tel:970-628-1505" class="bg-white text-blue-700">📞 Call Now</a>
    <button data-quote-popup class="bg-green-500 text-white">💬 Free Quote</button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('openQuoteModal'));
        });
      });
      const bar = document.getElementById('stickyCta');
      if (bar) {
        window.addEventListener('scroll', () => {
          bar.classList.toggle('visible', window.scrollY > 600);
        }, { passive: true });
      }
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('span:last-child');
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-toggle span:last-child').forEach(s => s.textContent = '+');
          if (!isOpen) { answer.classList.add('open'); icon.textContent = '−'; }
        });
      });
    });
  </script>
</Layout>
