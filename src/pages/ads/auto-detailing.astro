---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const title = "Professional Auto Detailing | ColorAuto Detailing";
const description = "Expert auto detailing services in Grand Junction. Hand wash, interior cleaning, exterior protection. Book your appointment now!";
const keywords = ['auto detailing', 'car detailing', 'professional detailing', 'Grand Junction'];
---

<Layout {title} {description} {keywords} noindex={true} hideChat={true}>
  <QuoteModal client:load isOpen={false} service="Auto Detailing" source="google_ads" />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/autodetailing.jpg" alt="Auto Detailing" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Professional Auto Detailing</h1>
      <p class="text-2xl text-gray-200 drop-shadow-md mb-8">Restore Your Car's Showroom Shine</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition shadow-lg inline-block">
          Call Now: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-lg inline-block cursor-pointer border-0">
          Get Free Quote
        </button>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-6 md:gap-10 text-sm text-gray-600">
      <div class="flex items-center gap-2"><span class="text-yellow-500 text-lg">★★★★★</span><span class="font-semibold">4.9/5</span> Google Reviews</div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Certified Installers</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Same-Week Availability</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Warranty Backed</span></div>
    </div>
  </section>

  <!-- Quick Benefits -->
  <section class="bg-gradient-to-b from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-extrabold text-center mb-12">Why Choose ColorAuto Detailing?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">⭐</div>
          <h3 class="font-extrabold text-2xl mb-3">5-Star Rated</h3>
          <p class="text-blue-100 leading-relaxed">Trusted by local drivers with proven results and consistent excellence</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">💎</div>
          <h3 class="font-extrabold text-2xl mb-3">Premium Products</h3>
          <p class="text-blue-100 leading-relaxed">Only top-tier brands and professional techniques for best results</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🏆</div>
          <h3 class="font-extrabold text-2xl mb-3">Expert Team</h3>
          <p class="text-blue-100 leading-relaxed">Certified professionals with years of hands-on experience</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Included -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">What's Included</h2>
      <ul class="space-y-3">
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Professional hand wash with pH-balanced soap</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Interior vacuuming and sanitization</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Exterior polish and wax protection</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Wheel and tire cleaning</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Glass and trim treatment</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Our Process -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Our Detailing Process</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">1</div>
          <h3 class="font-bold text-xl mb-2">Inspection</h3>
          <p class="text-gray-600">We assess your vehicle's condition and identify problem areas</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">2</div>
          <h3 class="font-bold text-xl mb-2">Deep Clean</h3>
          <p class="text-gray-600">Thorough interior and exterior cleaning with premium products</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">3</div>
          <h3 class="font-bold text-xl mb-2">Polish & Protect</h3>
          <p class="text-gray-600">Paint correction and protective coating application</p>
        </div>
        <div class="text-center">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold text-blue-600">4</div>
          <h3 class="font-bold text-xl mb-2">Final Detail</h3>
          <p class="text-gray-600">Finishing touches and quality inspection</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/After Gallery -->
  <section class="bg-gradient-to-b from-gray-100 to-white py-16">
    <div class="max-w-6xl mx-auto px-4 text-center space-y-4">
      <h2 class="text-4xl font-bold">Tailored Detailing For Real Customers</h2>
      <p class="text-xl text-gray-600">We match the package to the vehicle's condition so you get only what you need.</p>
    </div>
  </section>

  <!-- Service Packages -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Detailing Packages</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Maintenance Detail</h3>
          <p class="text-gray-600 mb-6">For regularly maintained vehicles</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Exterior hand wash & wheel faces</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Vacuum & interior wipe-down</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Glass inside & out</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Tire dressing</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-blue-600 hover:border-blue-700 transition transform scale-105">
          <div class="bg-blue-600 text-white text-sm font-bold py-1 px-3 rounded-full inline-block mb-4">POPULAR</div>
          <h3 class="text-2xl font-bold mb-4">Interior / Exterior Detail</h3>
          <p class="text-gray-600 mb-6">Deep clean for both cabin and paint</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Shampoo carpets & seats or leather clean/condition</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Clay bar & light polish on paint</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Door jambs, vents, and trims detailed</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Protective sealant applied</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Full Detail</h3>
          <p class="text-gray-600 mb-6">Our most thorough interior + exterior reset</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Everything in Interior/Exterior Detail</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Engine bay clean & dress</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Headliner spot treatment</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Extended protection options (sealant or ceramic add-on)</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Other Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gray-50 rounded-lg shadow p-8 border border-gray-200">
          <div class="flex items-baseline justify-between mb-4">
            <h3 class="text-2xl font-bold">Hand Wash</h3>
            <span class="text-xl font-semibold text-blue-700">$45+</span>
          </div>
          <p class="text-gray-600 mb-4">Premium hand wash with pH-balanced care</p>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Premium hand wash with pH-balanced soap</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Wheels cleaned</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Exterior windows</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Towel and compressed air dried</span></li>
          </ul>
        </div>
        <div class="bg-gray-50 rounded-lg shadow p-8 border border-gray-200">
          <div class="flex items-baseline justify-between mb-4">
            <h3 class="text-2xl font-bold">Maintenance Detail</h3>
            <span class="text-xl font-semibold text-blue-700">$125+</span>
          </div>
          <p class="text-gray-600 mb-4">Everything in Hand Wash plus added protection and interior care</p>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Everything in the Hand Wash</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Spray wax</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Vacuum carpets, seats, and floor mats</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Wipe down and dust interior plastic trim</span></li>
            <li class="flex items-start"><span class="text-green-600 mr-2">•</span><span>Interior windows</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">What Our Customers Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Best detailing service in Grand Junction! My car looks brand new again. The team was professional and thorough."</p>
          <p class="font-bold">- Michael R.</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Amazing attention to detail. They got stains out of my seats I thought were permanent. Highly recommend!"</p>
          <p class="font-bold">- Sarah K.</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Outstanding service! They went above and beyond. My truck has never looked this good. Worth every penny."</p>
          <p class="font-bold">- James T.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4" id="faq-list">
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How long does a full detail take?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            A maintenance detail takes 1-2 hours, an interior/exterior detail takes 3-5 hours, and a full detail can take a full day depending on the vehicle's condition.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How often should I get my car detailed?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            We recommend a maintenance detail every 4-6 weeks and a full detail 2-4 times per year, depending on driving conditions and how you maintain your vehicle between visits.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Do you detail trucks and SUVs?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            Absolutely. We detail all vehicle types including cars, trucks, SUVs, and even boats and RVs. Pricing varies based on vehicle size and condition.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            What products do you use?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 text-gray-600">
            We use only professional-grade, pH-balanced products from trusted brands. Our chemicals are safe for all paint types, clear coats, and interior surfaces.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-white border-t-4 border-blue-600 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Transform Your Vehicle?</h2>
      <p class="text-xl text-gray-600 mb-8">Limited-time specials available. Book your detailing appointment today!</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          ☎️ Call: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition border-0 cursor-pointer">
          📧 Get Free Quote
        </button>
      </div>
      <p class="text-sm text-gray-500 mt-6">📍 562 S. Westgate Drive, Grand Junction, CO</p>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="sticky-cta-bar" id="stickyCta">
    <a href="tel:970-628-1505" class="bg-white text-blue-700">📞 Call Now</a>
    <button data-quote-popup class="bg-green-500 text-white">💬 Free Quote</button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('openQuoteModal'));
        });
      });
      const bar = document.getElementById('stickyCta');
      if (bar) {
        window.addEventListener('scroll', () => {
          bar.classList.toggle('visible', window.scrollY > 600);
        }, { passive: true });
      }
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('span:last-child');
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-toggle span:last-child').forEach(s => s.textContent = '+');
          if (!isOpen) { answer.classList.add('open'); icon.textContent = '−'; }
        });
      });
    });
  </script>
</Layout>
