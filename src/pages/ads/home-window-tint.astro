---
import Layout from '../../layouts/Layout.astro';
import QuoteModal from '../../components/features/QuoteModal';

const title = "Home Window Tinting | Residential Tint | ColorAuto Detailing";
const description = "Professional home window tinting in Grand Junction. Energy savings, UV protection, privacy. Premium residential window film installation.";
const keywords = ['home window tinting', 'residential window tint', 'home energy savings', 'Grand Junction'];
---

<Layout {title} {description} {keywords} noindex={true}>
  <QuoteModal client:load isOpen={false} service="Home Window Tinting" source="google_ads" />
  <!-- Hero Section -->
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/homewindowtint.jpg" alt="Home Window Tint" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Home Window Tinting</h1>
      <p class="text-2xl text-gray-200 drop-shadow-md mb-8">Energy Savings & Privacy for Your Home</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition shadow-lg inline-block">
          Call Now: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-700 transition shadow-lg inline-block cursor-pointer border-0">
          Get Free Quote
        </button>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-6 md:gap-10 text-sm text-gray-600">
      <div class="flex items-center gap-2"><span class="text-yellow-500 text-lg">★★★★★</span><span class="font-semibold">4.9/5</span> Google Reviews</div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Certified Installers</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Same-Week Availability</span></div>
      <div class="flex items-center gap-2"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Warranty Backed</span></div>
    </div>
  </section>

  <!-- Quick Benefits -->
  <section class="bg-gradient-to-b from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-extrabold text-center mb-12">Home Window Tinting Benefits</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">💰</div>
          <h3 class="font-extrabold text-2xl mb-3">Lower Energy Bills</h3>
          <p class="text-blue-100 leading-relaxed">Save up to 30% on heating and cooling costs</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">☀️</div>
          <h3 class="font-extrabold text-2xl mb-3">UV Protection</h3>
          <p class="text-blue-100 leading-relaxed">Blocks 99% of harmful UV rays</p>
        </div>
        <div class="group bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 hover:bg-white/20 hover:border-white/40 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="text-6xl mb-4">🔒</div>
          <h3 class="font-extrabold text-2xl mb-3">Privacy & Safety</h3>
          <p class="text-blue-100 leading-relaxed">More privacy and window reinforcement</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Home Tinting Benefits -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">Why Home Window Tinting?</h2>
      <ul class="space-y-3">
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Reduces heating and cooling costs significantly</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Blocks 99% of UV rays that fade furniture</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Increased privacy from street view</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Enhanced safety with shatter protection</span>
        </li>
        <li class="flex items-start text-lg">
          <span class="text-green-600 font-bold text-2xl mr-3">✓</span>
          <span>Improves year-round comfort</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Film Options -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Home Window Film Options</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Solar Control</h3>
          <p class="text-gray-600 mb-6">Heat & glare reduction</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Up to 80% heat reduction</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>99% UV protection</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Maintains natural light</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Energy cost savings</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-blue-600 hover:border-blue-700 transition transform scale-105">
          <div class="bg-blue-600 text-white text-sm font-bold py-1 px-3 rounded-full inline-block mb-4">POPULAR</div>
          <h3 class="text-2xl font-bold mb-4">Privacy Film</h3>
          <p class="text-gray-600 mb-6">Daytime privacy enhancement</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>One-way daytime privacy</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Heat rejection</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Maintains view from inside</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Multiple tint levels</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 border-2 border-gray-200 hover:border-blue-500 transition">
          <h3 class="text-2xl font-bold mb-4">Security Film</h3>
          <p class="text-gray-600 mb-6">Safety & protection</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Shatter-resistant</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Break-in protection</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Storm protection</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>UV protection included</span>
            </li>
          </ul>
          <button data-quote-popup class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition border-0 cursor-pointer">Get Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Energy Savings -->
  <section class="bg-gradient-to-b from-gray-100 to-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Real Energy Savings</h2>
      <p class="text-xl text-gray-600 text-center mb-12">See how window tinting reduces your energy costs</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img src="/images/homeflatwindowtint.jpg" alt="Home window tinting" class="rounded-lg shadow-xl" />
        </div>
        <div>
          <h3 class="text-2xl font-bold mb-6">Average Household Savings</h3>
          <div class="space-y-4">
            <div class="bg-white p-6 rounded-lg shadow">
              <p class="text-gray-600 mb-2">Summer Cooling Costs</p>
              <p class="text-3xl font-bold text-green-600">Save 25-30%</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow">
              <p class="text-gray-600 mb-2">Winter Heating Costs</p>
              <p class="text-3xl font-bold text-green-600">Save 15-20%</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow">
              <p class="text-gray-600 mb-2">ROI Timeline</p>
              <p class="text-3xl font-bold text-blue-600">3-7 Years</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/After Benefits -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Protect Your Home Investment</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-gray-50 rounded-lg p-8 shadow-lg">
          <h3 class="text-2xl font-bold mb-4 text-red-600">Without Window Tint</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-red-600 mr-2">✗</span>
              <span>Faded furniture & flooring</span>
            </li>
            <li class="flex items-start">
              <span class="text-red-600 mr-2">✗</span>
              <span>High energy bills</span>
            </li>
            <li class="flex items-start">
              <span class="text-red-600 mr-2">✗</span>
              <span>Uncomfortable hot spots</span>
            </li>
            <li class="flex items-start">
              <span class="text-red-600 mr-2">✗</span>
              <span>No privacy during day</span>
            </li>
            <li class="flex items-start">
              <span class="text-red-600 mr-2">✗</span>
              <span>Excessive glare</span>
            </li>
          </ul>
        </div>
        <div class="bg-blue-50 rounded-lg p-8 shadow-lg">
          <h3 class="text-2xl font-bold mb-4 text-green-600">With Window Tint</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Protected furniture & flooring</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Lower energy costs</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Consistent temperature</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Daytime privacy</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Reduced glare</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">What Homeowners Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Our energy bill dropped by $80/month! The living room doesn't overheat anymore and my furniture isn't fading. Great investment!"</p>
          <p class="font-bold">- Patricia J.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"Love the privacy it provides during the day. Installation was quick and professional. Would definitely recommend ColorAuto!"</p>
          <p class="font-bold">- Gary S.</p>
        </div>
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <div class="text-yellow-500 text-2xl mb-4">★★★★★</div>
          <p class="text-gray-700 mb-4 italic">"The tinting has made such a difference in comfort. No more blinding afternoon sun, and we're saving money every month!"</p>
          <p class="font-bold">- Nancy D.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4" id="faq-list">
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Will window tint make my home too dark inside?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Not at all. Our solar control films reduce heat and UV while maintaining natural light. We offer a range of shades so you can choose the level of light that works for your space.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How much can I save on energy bills?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Most homeowners see 15-30% savings on heating and cooling costs. The exact amount depends on window size, sun exposure, and your current energy usage.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            Does window tint protect furniture from fading?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Yes. Our films block 99% of UV rays, which are the primary cause of fading in furniture, flooring, artwork, and fabrics. It significantly extends the life of your interior furnishings.
          </div>
        </div>
        <div class="border border-gray-200 rounded-lg">
          <button class="faq-toggle w-full text-left px-6 py-4 font-semibold text-lg flex justify-between items-center cursor-pointer bg-transparent border-0">
            How long does residential window film last?
            <span class="text-blue-600 text-2xl">+</span>
          </button>
          <div class="faq-answer px-6 pb-4 text-gray-600">
            Quality residential window film typically lasts 15-25 years. Our films come with manufacturer warranties for your peace of mind.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-white border-t-4 border-blue-600 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Start Saving on Energy Today</h2>
      <p class="text-xl text-gray-600 mb-8">Professional home window tinting with professional installation</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:970-628-1505" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          ☎️ Call: 970-628-1505
        </a>
        <button data-quote-popup class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition border-0 cursor-pointer">
          📧 Get Free Quote
        </button>
      </div>
      <p class="text-sm text-gray-500 mt-6">📍 562 S. Westgate Drive, Grand Junction, CO</p>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="sticky-cta-bar" id="stickyCta">
    <a href="tel:970-628-1505" class="bg-white text-blue-700">📞 Call Now</a>
    <button data-quote-popup class="bg-green-500 text-white">💬 Free Quote</button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('openQuoteModal'));
        });
      });
      const bar = document.getElementById('stickyCta');
      if (bar) {
        window.addEventListener('scroll', () => {
          bar.classList.toggle('visible', window.scrollY > 600);
        }, { passive: true });
      }
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('span:last-child');
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-toggle span:last-child').forEach(s => s.textContent = '+');
          if (!isOpen) { answer.classList.add('open'); icon.textContent = '−'; }
        });
      });
    });
  </script>
</Layout>
