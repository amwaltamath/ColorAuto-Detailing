---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="Page Not Found | ColorAuto"
  description="The page you're looking for doesn't exist. Browse our auto detailing, PPF, ceramic coating, and window tinting services in Grand Junction, CO."
  noindex={true}
>
  <section class="min-h-[70vh] flex items-center justify-center bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-2xl mx-auto px-4 text-center py-20">
      <p class="text-8xl font-extrabold text-blue-600 mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Page Not Found</h1>
      <p class="text-lg text-gray-600 mb-10">Sorry, we couldn't find the page you're looking for. It may have been moved or no longer exists.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="/" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition shadow-lg">
          Back to Home
        </a>
        <a href="/contact" class="bg-white border border-gray-200 text-gray-900 px-6 py-3 rounded-lg font-semibold shadow hover:border-blue-300 hover:text-blue-700 transition">
          Contact Us
        </a>
      </div>
      <div class="border-t border-gray-200 pt-8">
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Popular Services</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/services/auto-detailing" class="text-sm text-blue-600 hover:underline">Auto Detailing</a>
          <span class="text-gray-300">|</span>
          <a href="/services/paint-protection-film" class="text-sm text-blue-600 hover:underline">Paint Protection Film</a>
          <span class="text-gray-300">|</span>
          <a href="/services/ceramic-coating" class="text-sm text-blue-600 hover:underline">Ceramic Coating</a>
          <span class="text-gray-300">|</span>
          <a href="/services/window-tinting" class="text-sm text-blue-600 hover:underline">Window Tinting</a>
          <span class="text-gray-300">|</span>
          <a href="/services/color-ppf" class="text-sm text-blue-600 hover:underline">Color PPF</a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
