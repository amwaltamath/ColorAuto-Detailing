---
import PublicLayout from '../layouts/PublicLayout.astro';
import QuoteModal from '../components/features/QuoteModal';
---

<PublicLayout
  title="Professional Car Detailing in Grand Junction, CO | ColorAuto"
  description="Premium auto detailing, paint protection film (PPF), ceramic coating, and window tinting in Grand Junction, CO. Call 970-628-1505 for a free quote."
  keywords={[
    'car detailing Grand Junction',
    'paint protection film',
    'PPF Grand Junction',
    'ceramic coating',
    'window tinting',
    'auto detailing Colorado',
    'Color PPF'
  ]}
  image="/images/background.jpg"
>
  <QuoteModal client:load isOpen={false} service="General Quote" />
  <!-- Hero Section -->
  <section class="relative min-h-[80vh] md:min-h-screen text-white overflow-hidden">
    <!-- Background Image + Gradient -->
    <div class="absolute inset-0">
      <img src="/images/background.jpg" alt="Professional auto detailing service at ColorAuto in Grand Junction, Colorado" class="w-full h-full object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-black/65"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4">
      <div class="pt-28 md:pt-40 max-w-3xl">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight mb-6">
          Grand Junction Auto Detailing & Protection Experts
        </h1>
        <p class="text-lg md:text-xl text-gray-200 mb-6">
          Premium detailing, paint protection film, ceramic coating, and window tinting in Grand Junction.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <button data-quote-popup class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition shadow-lg border-0 cursor-pointer">Get a Free Quote</button>
          <a href="tel:970-628-1505" class="bg-white/10 backdrop-blur text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/20 transition border border-white/20">Call: 970-628-1505</a>
        </div>
      </div>
    </div>
  </section>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-quote-popup]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const event = new CustomEvent('openQuoteModal');
            document.dispatchEvent(event);
          });
        });
      });
    </script>

  <!-- Location Info -->
  <section class="bg-gray-100 py-6">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-gray-700 text-lg">📍 562 S. Westgate Drive, Grand Junction, Colorado</p>
      <p class="text-gray-600 mt-2">☎️ <a href="tel:970-628-1505" class="text-blue-600 font-semibold hover:underline">970-628-1505</a></p>
    </div>
  </section>

  <!-- Highlights Bar -->
  <section class="bg-white py-8 border-t">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col items-center">
        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mb-1">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z" /></svg>
        </div>
        <p class="mt-2 text-sm font-semibold text-gray-800">Premium Products</p>
        <p class="text-xs text-gray-500">Top-tier brands + pro techniques</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mb-1">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.745 3.745 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>
        </div>
        <p class="mt-2 text-sm font-semibold text-gray-800">Certified Installers</p>
        <p class="text-xs text-gray-500">PPF + Ceramic certified team</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mb-1">
          <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" /></svg>
        </div>
        <p class="mt-2 text-sm font-semibold text-gray-800">5-Star Rated</p>
        <p class="text-xs text-gray-500">Trusted by local drivers</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mb-1">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        </div>
        <p class="mt-2 text-sm font-semibold text-gray-800">Satisfaction Guarantee</p>
        <p class="text-xs text-gray-500">We stand behind our work</p>
      </div>
    </div>
  </section>

  <!-- Main Services -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Professional Car Detailing</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href="/services/auto-detailing" class="bg-white rounded-lg shadow-lg hover:shadow-xl transition overflow-hidden group">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/professional auto detailing.jpg" alt="Professional auto detailing and interior cleaning in Grand Junction" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, 33vw" />
          </div>
          <div class="p-8">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z" /></svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-800">Auto Detailing</h3>
            <p class="text-gray-600">
              Professional hand wash, clay treatment, and comprehensive detailing to restore your vehicle's finish.
            </p>
          </div>
        </a>
        <a href="/services/color-ppf" class="bg-white rounded-lg shadow-lg hover:shadow-xl transition overflow-hidden group">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/colorppf.jpg" alt="Color paint protection film wrap by ColorAuto" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, 33vw" />
          </div>
          <div class="p-8">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-800">Color PPF</h3>
            <p class="text-gray-600">
              The latest in paint protection technology with color-matching finish that looks factory-applied.
            </p>
          </div>
        </a>
        <a href="/services/ceramic-coating" class="bg-white rounded-lg shadow-lg hover:shadow-xl transition overflow-hidden group">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/ceramic coating.jpg" alt="Ceramic coating application for long-lasting vehicle protection" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, 33vw" />
          </div>
          <div class="p-8">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" /></svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-800">Ceramic Coating</h3>
            <p class="text-gray-600">
              Long-lasting protection that repels water, dirt, and UV rays for a glossy, mirror-like finish.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Services -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Our Specialty Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <a href="/services/paint-protection-film" class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden group" aria-label="Learn more about paint protection film services">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/Paint Protection Film.jpg" alt="XPEL paint protection film installation on vehicle hood" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw" />
          </div>
          <div class="p-8">
            <h3 class="text-xl font-bold mb-3 text-blue-600">Paint Protection Film</h3>
            <p class="text-gray-600 mb-4">
              Invisible protection that shields your paint from chips, scratches, and damage while maintaining clarity.
            </p>
            <span class="text-blue-600 font-semibold hover:underline">Learn More →</span>
          </div>
        </a>
        <a href="/services/window-tinting" class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden group" aria-label="Learn more about automotive window tinting">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/window tint.jpg" alt="Professional automotive window tinting service" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw" />
          </div>
          <div class="p-8">
            <h3 class="text-xl font-bold mb-3 text-blue-600">Automotive Window Tint</h3>
            <p class="text-gray-600 mb-4">
              Professional tint for vehicles with premium heat rejection and clarity.
            </p>
            <span class="text-blue-600 font-semibold hover:underline">Learn More →</span>
          </div>
        </a>
        <a href="/ads/home-window-tint" class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden group" aria-label="Learn more about home window tinting">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/homewindowtint.jpg" alt="Home window tinting for UV and heat reduction" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw" />
          </div>
          <div class="p-8">
            <h3 class="text-xl font-bold mb-3 text-blue-600">Home Window Tint</h3>
            <p class="text-gray-600 mb-4">
              Cut glare and heat while protecting interiors from UV at home.
            </p>
            <span class="text-blue-600 font-semibold hover:underline">Learn More →</span>
          </div>
        </a>
        <a href="/ads/office-window-tint" class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden group" aria-label="Learn more about office and commercial window tinting">
          <div class="relative h-48 overflow-hidden bg-gray-200">
            <img src="/images/officewindowtint.jpg" alt="Office and commercial window tinting for privacy and energy savings" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw" />
          </div>
          <div class="p-8">
            <h3 class="text-xl font-bold mb-3 text-blue-600">Office / Commercial Tint</h3>
            <p class="text-gray-600 mb-4">
              Comfort, privacy, and energy savings for offices and storefronts.
            </p>
            <span class="text-blue-600 font-semibold hover:underline">Learn More →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-gradient-to-br from-gray-900 to-gray-800 text-white py-20">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-4">Why Choose ColorAuto?</h2>
      <p class="text-center text-gray-400 mb-12 max-w-2xl mx-auto">Grand Junction's trusted experts for premium vehicle protection and detailing</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-8 text-center hover:bg-white/10 transition duration-300">
          <div class="w-14 h-14 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607Z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Attention to Detail</h3>
          <p class="text-gray-400">Meticulous process and premium products for flawless results.</p>
        </div>
        <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-8 text-center hover:bg-white/10 transition duration-300">
          <div class="w-14 h-14 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Protection That Lasts</h3>
          <p class="text-gray-400">PPF + ceramic solutions to keep your vehicle pristine.</p>
        </div>
        <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-8 text-center hover:bg-white/10 transition duration-300">
          <div class="w-14 h-14 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Local + Trusted</h3>
          <p class="text-gray-400">Grand Junction shop with 5-star service and support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8">What Customers Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="rounded-lg border p-6 shadow-sm">
          <div class="text-yellow-500 text-lg">★★★★★</div>
          <p class="mt-3 text-gray-700">“Paint correction + ceramic came out flawless. Looks brand new!”</p>
          <p class="mt-2 text-sm text-gray-500">— Alex R.</p>
        </div>
        <div class="rounded-lg border p-6 shadow-sm">
          <div class="text-yellow-500 text-lg">★★★★★</div>
          <p class="mt-3 text-gray-700">“PPF saved my bumper from rock chips. Install is seamless.”</p>
          <p class="mt-2 text-sm text-gray-500">— Jamie W.</p>
        </div>
        <div class="rounded-lg border p-6 shadow-sm">
          <div class="text-yellow-500 text-lg">★★★★★</div>
          <p class="mt-3 text-gray-700">“Fast window tint and great service. Cooler cabin instantly.”</p>
          <p class="mt-2 text-sm text-gray-500">— Chris M.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <p class="text-lg text-gray-600">Everything you need to know about our services</p>
      </div>
      <div class="grid gap-5">
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">How long does paint correction take?</h3>
              <p class="text-gray-600 leading-relaxed">Paint correction typically takes 6–12 hours depending on paint condition and vehicle size. We'll give you an accurate timeline during your consultation.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">How long does Paint Protection Film last?</h3>
              <p class="text-gray-600 leading-relaxed">Quality PPF like Xpel Ultimate Plus lasts 10+ years with proper care. It's self-healing and protects against rock chips, UV, and oxidation.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Can ceramic coating be applied over PPF?</h3>
              <p class="text-gray-600 leading-relaxed">Yes! We often layer ceramic on top of PPF for maximum protection and hydrophobic gloss. The combo is unbeatable.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">What's the aftercare for window tint?</h3>
              <p class="text-gray-600 leading-relaxed">For optimal results, keep windows fully closed for at least 48 hours following installation. Any residual moisture between the film and glass will cure out naturally over 5–7 days. All installations are backed by a lifetime warranty for your peace of mind.</p>
            </div>
          </div>
        </div>
