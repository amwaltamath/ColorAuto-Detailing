---
import PublicLayout from '../layouts/PublicLayout.astro';
import GoogleReviews from '../components/common/GoogleReviews.astro';
import GrandJunctionDetailingShowcase from '../components/features/GrandJunctionDetailingShowcase.astro';
import HeroDetailingVisual from '../components/features/HeroDetailingVisual.astro';
import ServiceGlassCard from '../components/common/ServiceGlassCard.astro';
import GlassLocationBar from '../components/common/GlassLocationBar.astro';
import GlassHighlightsBar from '../components/common/GlassHighlightsBar.astro';
import '../styles/hero-split.css';
import '../styles/glass-services.css';
import '../styles/service-page-glass.css';
---

<PublicLayout
  title="Professional Car Detailing in Grand Junction, CO | ColorAuto"
  description="Premium auto detailing, paint protection film (PPF), ceramic coating, and window tinting in Grand Junction, CO. Call 970-628-1505 for a free quote."
  keywords={[
    'car detailing Grand Junction',
    'paint protection film',
    'PPF Grand Junction',
    'ceramic coating',
    'window tinting',
    'auto detailing Colorado',
    'Color PPF'
  ]}
  image="/images/background.jpg"
>
  <!-- Hero Section -->
  <section class="ca-hero-split">
    <div class="ca-hero-split__inner">
      <div class="ca-hero-split__content">
        <span class="ca-hero-split__eyebrow">Grand Junction, Colorado</span>
        <h1 class="ca-hero-split__title">
          Grand Junction Auto Detailing &amp; Protection Experts
        </h1>
        <p class="ca-hero-split__subtitle">
          ColorAuto is the Western Slope&apos;s trusted shop for premium detailing, XPEL paint protection film,
          ceramic coating, and window tint — with 400+ Google reviews from local drivers.
        </p>
        <div class="ca-hero-split__actions">
          <button type="button" data-quote-popup class="ca-hero-split__btn-primary">
            Get a Free Quote
          </button>
          <a href="tel:970-628-1505" class="ca-hero-split__btn-secondary">
            Call 970-628-1505
          </a>
        </div>
        <ul class="ca-hero-split__trust">
          <li>XPEL certified installer</li>
          <li>Same-week scheduling</li>
          <li>562 S Westgate Drive</li>
        </ul>
      </div>

      <HeroDetailingVisual />
    </div>
  </section>

  <GlassLocationBar />
  <GlassHighlightsBar />

  <!-- Main Services -->
  <section class="ca-glass-section">
    <div class="ca-glass-section__inner">
      <div class="ca-glass-section__header">
        <span class="ca-glass-section__eyebrow">Core Services</span>
        <h2 class="ca-glass-section__title">Professional Car Detailing</h2>
        <p class="ca-glass-section__subtitle">
          Grand Junction&apos;s go-to shop for showroom-level detailing, color PPF, and ceramic protection.
        </p>
      </div>
      <div class="ca-glass-grid ca-glass-grid--main">
        <ServiceGlassCard
          href="/services/auto-detailing"
          image="/images/professional auto detailing.jpg"
          alt="Professional auto detailing and interior cleaning in Grand Junction"
          title="Auto Detailing"
          description="Hand wash, clay bar, paint correction, and full interior/exterior detailing for a mirror finish."
          badge="Most booked"
          tags={['Interior + Exterior', 'Paint correction']}
        />
        <ServiceGlassCard
          href="/services/color-ppf"
          image="/images/colorppf.jpg"
          alt="Color paint protection film wrap by ColorAuto"
          title="Color PPF"
          description="Factory-look color paint protection film that shields your finish while changing your style."
          badge="XPEL"
          tags={['Color change', 'Chip protection']}
        />
        <ServiceGlassCard
          href="/services/ceramic-coating"
          image="/images/ceramic coating.jpg"
          alt="Ceramic coating application for long-lasting vehicle protection"
          title="Ceramic Coating"
          description="Hydrophobic ceramic layers that repel dirt, UV, and Colorado road grime for years of gloss."
          badge="Long-lasting"
          tags={['5+ year gloss', 'UV protection']}
        />
      </div>
    </div>
  </section>

  <!-- Specialty Services -->
  <section class="ca-glass-section ca-glass-section--alt">
    <div class="ca-glass-section__inner">
      <div class="ca-glass-section__header">
        <span class="ca-glass-section__eyebrow">Specialty Services</span>
        <h2 class="ca-glass-section__title">Protection &amp; Window Tint</h2>
        <p class="ca-glass-section__subtitle">
          From XPEL paint protection to automotive, home, and commercial tint across the Western Slope.
        </p>
      </div>
      <div class="ca-glass-grid ca-glass-grid--specialty">
        <ServiceGlassCard
          href="/services/paint-protection-film"
          image="/images/Paint Protection Film.jpg"
          alt="XPEL paint protection film installation on vehicle hood"
          title="Paint Protection Film"
          description="Invisible XPEL film that stops rock chips, scratches, and road debris."
          badge="XPEL"
          tags={['Self-healing']}
          compact={true}
        />
        <ServiceGlassCard
          href="/services/window-tinting"
          image="/images/window tint.jpg"
          alt="Professional automotive window tinting service"
          title="Automotive Window Tint"
          description="Premium heat rejection and clarity built for Colorado sun and daily driving."
          badge="Prime XR"
          tags={['Lifetime warranty']}
          compact={true}
        />
        <ServiceGlassCard
          href="/ads/home-window-tint"
          image="/images/homewindowtint.jpg"
          alt="Home window tinting for UV and heat reduction"
          title="Home Window Tint"
          description="Cut glare, heat, and UV fade for more comfortable rooms at home."
          tags={['UV block', 'Energy savings']}
          compact={true}
        />
        <ServiceGlassCard
          href="/ads/office-window-tint"
          image="/images/officewindowtint.jpg"
          alt="Office and commercial window tinting for privacy and energy savings"
          title="Office / Commercial Tint"
          description="Privacy, comfort, and energy savings for offices, storefronts, and commercial spaces."
          tags={['Commercial', 'Privacy']}
          compact={true}
        />
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-gradient-to-br from-gray-900 to-gray-800 text-white py-20">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-4">Why Choose ColorAuto?</h2>
      <p class="text-center text-gray-400 mb-12 max-w-2xl mx-auto">Grand Junction's trusted experts for premium vehicle protection and detailing</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-8 text-center hover:bg-white/10 transition duration-300">
          <div class="w-14 h-14 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607Z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Attention to Detail</h3>
          <p class="text-gray-400">Meticulous process and premium products for flawless results.</p>
        </div>
        <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-8 text-center hover:bg-white/10 transition duration-300">
          <div class="w-14 h-14 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Protection That Lasts</h3>
          <p class="text-gray-400">PPF + ceramic solutions to keep your vehicle pristine.</p>
        </div>
        <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-8 text-center hover:bg-white/10 transition duration-300">
          <div class="w-14 h-14 rounded-full bg-blue-600/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Local + Trusted</h3>
          <p class="text-gray-400">Grand Junction shop with 5-star service and support.</p>
        </div>
      </div>
    </div>
  </section>

  <GrandJunctionDetailingShowcase />

  <GoogleReviews class="bg-white" showViewAll={true} limit={5} />

  <!-- FAQ -->
  <section class="py-20 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <p class="text-lg text-gray-600">Everything you need to know about our services</p>
      </div>
      <div class="grid gap-5">
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">How long does paint correction take?</h3>
              <p class="text-gray-600 leading-relaxed">Paint correction typically takes 6–12 hours depending on paint condition and vehicle size. We'll give you an accurate timeline during your consultation.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">How long does Paint Protection Film last?</h3>
              <p class="text-gray-600 leading-relaxed">Quality PPF like Xpel Ultimate Plus lasts 10+ years with proper care. It's self-healing and protects against rock chips, UV, and oxidation.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Can ceramic coating be applied over PPF?</h3>
              <p class="text-gray-600 leading-relaxed">Yes! We often layer ceramic on top of PPF for maximum protection and hydrophobic gloss. The combo is unbeatable.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">What's the aftercare for window tint?</h3>
              <p class="text-gray-600 leading-relaxed">For optimal results, keep windows fully closed for at least 48 hours following installation. Any residual moisture between the film and glass will cure out naturally over 5–7 days. All installations are backed by a lifetime warranty for your peace of mind.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Do you offer warranties?</h3>
              <p class="text-gray-600 leading-relaxed">Yes! Paint Protection Film includes a 10-year warranty, ceramic coating is guaranteed for longevity up to 4 years, and window tint features a lifetime warranty. All services include a workmanship guarantee.</p>
            </div>
          </div>
        </div>
        <div class="group bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-lg hover:border-blue-300 transition-all duration-300 cursor-pointer">
          <div class="flex items-start gap-4">
            <div class="text-2xl text-blue-600 flex-shrink-0 font-bold">Q.</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">How much does a full detail cost?</h3>
              <p class="text-gray-600 leading-relaxed">Pricing varies by vehicle size and condition. Call us at <a href="tel:970-628-1505" class="text-blue-600 font-semibold hover:underline">970-628-1505</a> or email <a href="mailto:admin@colorautodetailing.com" class="text-blue-600 font-semibold hover:underline">admin@colorautodetailing.com</a> for a free quote.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQPage Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How long does paint correction take?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Paint correction typically takes 6–12 hours depending on paint condition and vehicle size. We'll give you an accurate timeline during your consultation."
        }
      },
      {
        "@type": "Question",
        name: "How long does Paint Protection Film last?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Quality PPF like Xpel Ultimate Plus lasts 10+ years with proper care. It's self-healing and protects against rock chips, UV, and oxidation."
        }
      },
      {
        "@type": "Question",
        name: "Can ceramic coating be applied over PPF?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes! We often layer ceramic on top of PPF for maximum protection and hydrophobic gloss. The combo is unbeatable."
        }
      },
      {
        "@type": "Question",
        name: "What's the aftercare for window tint?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "For optimal results, keep windows fully closed for at least 48 hours following installation. Any residual moisture between the film and glass will cure out naturally over 5–7 days. All installations are backed by a lifetime warranty for your peace of mind."
        }
      },
      {
        "@type": "Question",
        name: "Do you offer warranties?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes! Paint Protection Film includes a 10-year warranty, ceramic coating is guaranteed for longevity up to 4 years, and window tint features a lifetime warranty. All services include a workmanship guarantee."
        }
      },
      {
        "@type": "Question",
        name: "How much does a full detail cost?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Pricing varies by vehicle size and condition. Call us at 970-628-1505 or email admin@colorautodetailing.com for a free quote."
        }
      }
    ]
  })} />

  <!-- Before / After Slider - Temporarily Hidden -->
  <!--
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-3xl font-bold">Before & After</h2>
      </div>
      <div class="grid grid-cols-1 gap-8">
        <BeforeAfter client:load beforeSrc="/images/paint correction.jpg" afterSrc="/images/professional auto detailing.jpg" alt="Paint correction vs detailed finish" initialSplit={0.5} />
      </div>
    </div>
  </section>
  -->

  <!-- CTA Section -->
  <section class="relative text-white py-32 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/protection.jpg" alt="Vehicle paint protection and detailing by ColorAuto" class="w-full h-full object-cover opacity-40" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-black/55"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold mb-4 drop-shadow-md">Ready to protect and enhance your vehicle?</h2>
      <p class="text-xl text-blue-100 mb-8">Contact us today for a free quote</p>
      <div class="flex flex-col md:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="bg-white text-blue-600 px-8 py-3 rounded font-bold hover:bg-gray-100 transition inline-block shadow-lg"
        >
          Contact Us
        </a>
        <a
          href="tel:970-628-1505"
          class="bg-blue-800 text-white px-8 py-3 rounded font-bold hover:bg-blue-900 transition inline-block shadow-lg"
        >
          Call Now: 970-628-1505
        </a>
      </div>
    </div>
  </section>
</PublicLayout>
