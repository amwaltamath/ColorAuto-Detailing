---
import PublicLayout from '../layouts/PublicLayout.astro';

type TeamMember = {
  name: string;
  role: string;
  roleClass: string;
  image: string;
  bio: string;
  tags: { label: string; accent?: boolean; accentClass?: string }[];
};

const team: TeamMember[] = [
  {
    name: 'Paul',
    role: 'Founder, Owner & Lead Installer',
    roleClass: 'text-blue-700',
    image: '/images/team/paul.jpg',
    bio: 'Founder and owner of ColorAuto Detailing, Paul leads a dedicated team of automotive care professionals committed to excellence in every detail. From expert installers to meticulous detailers, our crew shares a passion for protecting and enhancing your vehicle\'s appearance.',
    tags: [
      { label: 'Lead Installer', accent: true, accentClass: 'bg-blue-50 text-blue-700' },
      { label: 'Owner' },
      { label: 'CEO' },
    ],
  },
  {
    name: 'Ashlee',
    role: 'Window Tint Specialist',
    roleClass: 'text-emerald-700',
    image: '/images/team/ashlee.jpg',
    bio: 'Automotive tint and home and office film installer who leads the team in delivering high-quality, precise installations with a focus on customer satisfaction.',
    tags: [
      { label: 'Automotive Tint', accent: true, accentClass: 'bg-emerald-50 text-emerald-700' },
      { label: 'Home Window Tinting' },
      { label: 'Office Window Tint' },
    ],
  },
  {
    name: 'Window Film Team',
    role: 'Home & Office Window Film',
    roleClass: 'text-emerald-700',
    image: '/images/team/window-film-1.jpg',
    bio: 'Certified installer focused on residential and commercial window film — clean lines, lasting performance, and clear communication from measure to final walkthrough.',
    tags: [
      { label: 'Home Tint', accent: true, accentClass: 'bg-emerald-50 text-emerald-700' },
      { label: 'Office Tint' },
      { label: 'Film Install' },
    ],
  },
  {
    name: 'Install & Detail',
    role: 'Detailing Specialist',
    roleClass: 'text-gray-800',
    image: '/images/team/team-4.jpg',
    bio: 'Hands-on specialist keeping interiors and exteriors dialed in — from thorough cleans to the finishing touches customers notice when they pick up their vehicle.',
    tags: [
      { label: 'Interior', accent: true, accentClass: 'bg-gray-100 text-gray-800' },
      { label: 'Exterior' },
      { label: 'Finishing' },
    ],
  },
  {
    name: 'Detailing Team',
    role: 'Detailing Technician',
    roleClass: 'text-red-700',
    image: '/images/team/team-5.jpg',
    bio: 'Shop-floor technician supporting paint correction, protection installs, and daily detailing workflows with an eye for consistency and quality.',
    tags: [
      { label: 'Detailing', accent: true, accentClass: 'bg-red-50 text-red-700' },
      { label: 'PPF Support' },
      { label: 'Quality' },
    ],
  },
  {
    name: 'Evan',
    role: 'Detailing Technician',
    roleClass: 'text-red-700',
    image: '/images/team/evan.jpg',
    bio: 'Focused on interior/exterior restoration, engine bay care, and meticulous finishing work.',
    tags: [
      { label: 'Interior', accent: true, accentClass: 'bg-red-50 text-red-700' },
      { label: 'Exterior' },
      { label: 'Finishing' },
    ],
  },
  {
    name: 'Jacob',
    role: 'Professional Detailer',
    roleClass: 'text-blue-700',
    image: '/images/team/jacob.jpg',
    bio: 'Detail specialist focused on quality and customer satisfaction.',
    tags: [
      { label: 'Quality Check', accent: true, accentClass: 'bg-blue-50 text-blue-700' },
      { label: 'Paint Correction' },
      { label: 'Detailer' },
    ],
  },
];
---

<PublicLayout
  title="Our Team - ColorAuto"
  description="Meet the ColorAuto Detailing team in Grand Junction — certified installers and detailing professionals."
  keywords={[
    'ColorAuto team',
    'professional detailers',
    'certified installers',
    'Grand Junction auto shop'
  ]}
  image="/images/ourteam.JPG"
>
  <section class="relative text-white py-70 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/ourteam.JPG" alt="ColorAuto Detailing team of professional installers in Grand Junction, CO" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 text-center">
      <p class="text-sm font-semibold text-blue-200 tracking-wide mb-3">Meet the people behind the gloss</p>
      <h1 class="text-5xl font-bold mb-4 drop-shadow-lg">Our Team</h1>
      <p class="text-xl text-gray-200 drop-shadow-md max-w-3xl mx-auto">At ColorAuto Detailing, our team is more than just a group of professionals— we're a family united by a passion for automotive excellence. Each member brings unique skills and dedication to ensure every vehicle we touch receives unparalleled care and attention to detail.</p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-gray-900 mb-10">Meet Our Specialists</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {team.map((member) => (
          <div class="group rounded-2xl border border-gray-100 bg-gradient-to-b from-white to-gray-50 p-8 shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="flex items-center gap-4 mb-4">
              <img
                src={member.image}
                alt={`${member.name} — ${member.role}`}
                class="h-20 w-20 rounded-2xl object-cover object-top shadow-lg"
                loading="lazy"
                width="80"
                height="80"
              />
              <div>
                <h3 class="text-xl font-bold text-gray-900">{member.name}</h3>
                <p class={`text-sm font-semibold ${member.roleClass}`}>{member.role}</p>
              </div>
            </div>
            <p class="text-gray-600 leading-relaxed">{member.bio}</p>
            <div class="mt-4 flex flex-wrap gap-2 text-xs text-gray-600">
              {member.tags.map((tag) => (
                <span
                  class:list={[
                    'px-3 py-1 rounded-full font-semibold',
                    tag.accent ? tag.accentClass : 'bg-gray-100',
                  ]}
                >
                  {tag.label}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Ready to work with us?</h2>
      <p class="text-lg text-gray-600 mb-8">Call or message the team—let's protect and elevate your vehicle with a plan tailored to you.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold shadow hover:bg-blue-700 transition">Contact the Shop</a>
        <a href="tel:970-628-1505" class="bg-white border border-gray-200 text-gray-900 px-6 py-3 rounded-lg font-semibold shadow hover:border-blue-300 hover:text-blue-700 transition">Call 970-628-1505</a>
      </div>
    </div>
  </section>
</PublicLayout>
