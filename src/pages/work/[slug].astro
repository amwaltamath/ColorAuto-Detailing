---
import { getCollection } from 'astro:content';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { getSupabaseBlogPostBySlug, getSupabaseBlogPosts } from '../../utils/blogPosts';
import { SITE_ORIGIN } from '../../utils/seo';
import { renderMarkdown } from '../../utils/renderMarkdown';
import { blogCategoryPreset } from '../../utils/blogCategoryPresets';

const SERVICE_LINKS: Record<string, { href: string; name: string; pitchTitle: string; pitch: string }> = {
  'window-tint': {
    href: '/services/window-tinting',
    name: 'window tinting',
    pitchTitle: 'Ready for window tint in Grand Junction?',
    pitch: 'Automotive, home, and office film with a legal shade and a clear quote before we start.',
  },
  ppf: {
    href: '/services/paint-protection-film',
    name: 'paint protection film',
    pitchTitle: 'Ready for paint protection film?',
    pitch: 'Tell us the vehicle and coverage you want. We will quote XPEL film for a Grand Junction install.',
  },
  'color-ppf': {
    href: '/services/color-ppf',
    name: 'Color PPF',
    pitchTitle: 'Ready for Color PPF?',
    pitch: 'Send the vehicle and the look you want. We will quote a color change film install.',
  },
  'ceramic-coating': {
    href: '/services/ceramic-coating',
    name: 'ceramic coating',
    pitchTitle: 'Ready for ceramic coating?',
    pitch: 'Tell us the vehicle size and condition. We will recommend a coating package and quote it.',
  },
  detailing: {
    href: '/services/auto-detailing',
    name: 'auto detailing',
    pitchTitle: 'Ready for a detail?',
    pitch: 'Tell us the vehicle and how you want it to look. We will match a detailing package and quote it.',
  },
};

const slug = Astro.params.slug || '';
const dbPost = slug ? await getSupabaseBlogPostBySlug(slug) : null;
const allDbPosts = await getSupabaseBlogPosts();

let localPost: (Awaited<ReturnType<typeof getCollection>>)[number] | null = null;
let Content: ((props: Record<string, any>) => any) | null = null;

if (!dbPost) {
  const localPosts = await getCollection('blog');
  localPost = localPosts.find((candidate) => candidate.slug === slug) || null;

  if (localPost) {
    const rendered = await localPost.render();
    Content = rendered.Content;
  }
}

if (!dbPost && !localPost) {
  return Astro.redirect('/work');
}

const postData = dbPost
  ? {
      slug: dbPost.slug,
      title: dbPost.title,
      description: dbPost.description,
      publishDate: dbPost.publishDate,
      image: dbPost.image,
      imageAlt: dbPost.imageAlt,
      category: dbPost.category,
      location: dbPost.location,
      author: dbPost.author,
    }
  : {
      slug: localPost!.slug,
      title: localPost!.data.title,
      description: localPost!.data.description,
      publishDate: localPost!.data.publishDate,
      image: localPost!.data.image,
      imageAlt: localPost!.data.imageAlt,
      category: localPost!.data.category,
      location: localPost!.data.location,
      author: localPost!.data.author,
    };

const siteUrl = SITE_ORIGIN;

// Format date
const formattedDate = postData.publishDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

// ISO date for structured data
const isoDate = postData.publishDate.toISOString();

const categoryLabel = postData.category.replace(/-/g, ' ');
const serviceLink = SERVICE_LINKS[postData.category] ?? {
  href: '/services',
  name: 'our services',
  pitchTitle: 'Ready to book?',
  pitch: 'Tell us the vehicle and what you want done. We will quote the right service.',
};

const bodyHtml = dbPost?.bodyMarkdown?.trim() ? renderMarkdown(dbPost.bodyMarkdown) : '';
const installPreset = blogCategoryPreset(postData.category);
const useCategoryInstall = Boolean(dbPost) && (!dbPost?.bodyMarkdown || dbPost.bodyMarkdown.includes('## Installation Process'));

const sortedOthers = [
  ...allDbPosts.map((post) => ({
    slug: post.slug,
    title: post.title,
    description: post.description,
    publishDate: post.publishDate,
    image: post.image,
    imageAlt: post.imageAlt,
    category: post.category,
  })),
  ...(await getCollection('blog'))
    .filter((post) => !allDbPosts.some((db) => db.slug === post.slug))
    .map((post) => ({
      slug: post.slug,
      title: post.data.title,
      description: post.data.description,
      publishDate: post.data.publishDate,
      image: post.data.image,
      imageAlt: post.data.imageAlt,
      category: post.data.category,
    })),
]
  .filter((post) => post.slug !== postData.slug)
  .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());

const sameCategory = sortedOthers.filter((post) => post.category === postData.category);
const relatedPosts = [...sameCategory, ...sortedOthers.filter((post) => post.category !== postData.category)].slice(0, 3);
const relatedHeading = sameCategory.length > 0 ? `More ${categoryLabel}` : 'Latest posts';

// BlogPosting schema
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: postData.title,
  description: postData.description,
  image: postData.image.startsWith('http') ? postData.image : new URL(postData.image, siteUrl).href,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    "@type": "Organization",
    name: postData.author,
    url: siteUrl,
  },
  publisher: {
    "@type": "Organization",
    name: "ColorAuto Detailing",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/images/ColorAuto.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(`/work/${postData.slug}`, siteUrl).href,
  },
  keywords: [postData.category, "Grand Junction", "ColorAuto", postData.location],
};
---

<PublicLayout
  title={`${postData.title} | ColorAuto`}
  description={postData.description}
  keywords={[
    postData.category,
    'Grand Junction',
    'ColorAuto',
    'auto detailing',
    'paint protection',
    postData.location
  ]}
  image={postData.image}
>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'Our Work', href: '/our-work' },
    { label: postData.title }
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <article class="bg-slate-50">
    <header class="relative min-h-[28rem] md:min-h-[34rem] overflow-hidden">
      <img
        src={postData.image}
        alt={postData.imageAlt}
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/20"></div>
      <div class="relative z-10 flex min-h-[28rem] md:min-h-[34rem] items-end">
        <div class="max-w-6xl mx-auto px-4 pb-16 md:pb-20 w-full text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-200 mb-4">{categoryLabel}</p>
          <h1 class="text-3xl md:text-5xl font-bold leading-tight max-w-4xl">{postData.title}</h1>
          <p class="mt-4 max-w-2xl text-base md:text-lg text-slate-200">{postData.description}</p>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <time class="rounded-full bg-white/10 px-3 py-1 backdrop-blur">{formattedDate}</time>
            <span class="rounded-full bg-white/10 px-3 py-1 backdrop-blur">{postData.location}</span>
            <span class="rounded-full bg-white/10 px-3 py-1 backdrop-blur">{postData.author}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 -mt-10 relative z-20 pb-16">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <div class="ca-article bg-white rounded-3xl border border-slate-200 shadow-xl px-6 py-8 md:px-10 md:py-12">
        {bodyHtml && !useCategoryInstall ? (
          <Fragment set:html={bodyHtml} />
        ) : dbPost ? (
          <>
            <p>{dbPost.projectSummary}</p>

            <h2>Services Performed</h2>
            <ul>
              {dbPost.servicesPerformed.map((service) => (
                <li>{service}</li>
              ))}
            </ul>

            <h2>Installation Process</h2>
            <ol>
              {installPreset.steps.map((step) => (
                <li><strong>{step.title}</strong>: {step.detail}</li>
              ))}
            </ol>

            <h2>Results</h2>
            <p>This {serviceLink.name} project is finished and ready for daily use, with care instructions covered at delivery.</p>

            <p><strong>Location</strong>: {dbPost.location}<br /><strong>Service Time</strong>: {dbPost.duration}<br /><strong>{installPreset.productLabel}</strong>: {dbPost.materialHighlight}</p>

            <p>Want the same result? See our <a href={dbPost.ctaHref || installPreset.ctaHref}>{dbPost.ctaLabel || installPreset.ctaLabel}</a> or <a href="/contact">request a quote</a>. Call <strong>{dbPost.phoneNumber}</strong>.</p>
          </>
        ) : (
          Content && <Content />
        )}

      {dbPost && dbPost.gallery.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-200">
          <h3 class="text-3xl font-bold mb-8 text-center text-gray-900">Project Gallery</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {dbPost.gallery.map((item) => (
              <div class="group overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition duration-300">
                <img 
                  src={item.src}
                  alt={item.alt}
                  class="w-full h-64 object-cover group-hover:scale-110 transition duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )}

        <div class="ca-article-cta mt-12 rounded-2xl bg-slate-950 p-8">
          <h2>{serviceLink.pitchTitle}</h2>
          <p>{serviceLink.pitch}</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="ca-article-cta__primary">Get a free quote</a>
            <a href={serviceLink.href} class="ca-article-cta__secondary">View {serviceLink.name}</a>
          </div>
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <div class="rounded-3xl bg-blue-700 text-white p-6 shadow-lg">
          <p class="text-xs uppercase tracking-wide text-blue-100">Grand Junction shop</p>
          <h2 class="text-xl font-bold mt-2">Book {serviceLink.name}</h2>
          <p class="text-sm text-blue-100 mt-2">562 S Westgate Drive. Same-week appointments are often open.</p>
          <a href={serviceLink.href} class="mt-5 inline-flex w-full justify-center rounded-lg bg-white text-blue-800 font-semibold px-4 py-3">See {serviceLink.name}</a>
        </div>
        {relatedPosts.length > 0 && (
          <div class="rounded-3xl bg-white border border-slate-200 p-5 shadow-sm">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">{relatedHeading}</h2>
            <div class="mt-4 space-y-4">
              {relatedPosts.map((post) => (
                <a href={`/work/${post.slug}`} class="flex gap-3 group">
                  <img src={post.image} alt={post.imageAlt} class="h-16 w-16 rounded-xl object-cover shrink-0" />
                  <span>
                    <time class="text-xs text-slate-400">{post.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
                    <span class="block text-sm font-semibold text-slate-900 group-hover:text-blue-700 leading-snug">{post.title}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
        <a href="/work" class="block text-sm font-semibold text-blue-700 hover:underline">All projects</a>
      </aside>
      </div>
    </div>
  </article>
</PublicLayout>

<style>
  .ca-article :global(.ca-article-cta h2) {
    color: #ffffff;
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }
  .ca-article :global(.ca-article-cta p) {
    color: #e2e8f0;
    font-size: 1rem;
    margin: 0 0 1.25rem;
  }
  .ca-article :global(.ca-article-cta a) {
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
  }
  .ca-article :global(.ca-article-cta__primary) {
    background: #ffffff;
    color: #0f172a;
  }
  .ca-article :global(.ca-article-cta__secondary) {
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .ca-article :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin: 2.5rem 0 0.85rem;
    letter-spacing: -0.02em;
  }
  .ca-article :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e3a8a;
    margin: 1.75rem 0 0.6rem;
  }
  .ca-article :global(p) {
    color: #334155;
    line-height: 1.75;
    margin: 0.9rem 0;
    font-size: 1.05rem;
  }
  .ca-article :global(ul),
  .ca-article :global(ol) {
    margin: 1rem 0 1.25rem;
    padding-left: 1.25rem;
    color: #334155;
  }
  .ca-article :global(li) {
    margin: 0.4rem 0;
    line-height: 1.6;
  }
  .ca-article :global(a) {
    color: #1d4ed8;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ca-article :global(strong) {
    color: #0f172a;
  }
  .ca-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0 1.75rem;
    font-size: 0.95rem;
    overflow: hidden;
    border-radius: 0.75rem;
  }
  .ca-article :global(th) {
    background: #0f172a;
    color: white;
    text-align: left;
    padding: 0.75rem 1rem;
  }
  .ca-article :global(td) {
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 1rem;
    color: #334155;
  }
  .ca-article :global(tr:nth-child(even) td) {
    background: #f8fafc;
  }
  .ca-article :global(img) {
    border-radius: 1rem;
    margin: 1.5rem 0;
  }
  .prose img {
    border-radius: 0.75rem;
    box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.15);
    margin: 2rem 0;
    transition: all 0.3s ease;
  }
  
  .prose img:hover {
    box-shadow: 0 30px 50px -5px rgba(0, 0, 0, 0.25);
    transform: translateY(-4px);
  }
  
  .prose a {
    color: #2563eb;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
  }
  
  .prose a:hover {
    color: #1d4ed8;
    border-bottom-color: #2563eb;
  }
  
  .prose blockquote {
    border-left: 4px solid #2563eb;
    background-color: #f0f9ff;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #374151;
  }
  
  .prose code {
    background-color: #f3f4f6;
    color: #1f2937;
    padding: 0.5rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }
  
  .prose pre {
    background-color: #111827;
    color: #f3f4f6;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Enhanced list styling */
  .prose ul {
    list-style: none;
  }

  /* Table styling */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .prose table th {
    background-color: #2563eb;
    color: white;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
  }

  .prose table td {
    border: 1px solid #e5e7eb;
    padding: 0.75rem 1rem;
    color: #374151;
  }

  .prose table tr:nth-child(even) {
    background-color: #f9fafb;
  }

  /* Better spacing for hero section */
  article {
    display: flex;
    flex-direction: column;
  }
</style>
