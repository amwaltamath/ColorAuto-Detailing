---
import { getCollection } from 'astro:content';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { getSupabaseBlogPostBySlug } from '../../utils/blogPosts';

const slug = Astro.params.slug || '';
const dbPost = slug ? await getSupabaseBlogPostBySlug(slug) : null;

let localPost: (Awaited<ReturnType<typeof getCollection>>)[number] | null = null;
let Content: ((props: Record<string, any>) => any) | null = null;

if (!dbPost) {
  const localPosts = await getCollection('blog');
  localPost = localPosts.find((candidate) => candidate.slug === slug) || null;

  if (localPost) {
    const rendered = await localPost.render();
    Content = rendered.Content;
  }
}

if (!dbPost && !localPost) {
  return Astro.redirect('/work');
}

const postData = dbPost
  ? {
      slug: dbPost.slug,
      title: dbPost.title,
      description: dbPost.description,
      publishDate: dbPost.publishDate,
      image: dbPost.image,
      imageAlt: dbPost.imageAlt,
      category: dbPost.category,
      location: dbPost.location,
      author: dbPost.author,
    }
  : {
      slug: localPost!.slug,
      title: localPost!.data.title,
      description: localPost!.data.description,
      publishDate: localPost!.data.publishDate,
      image: localPost!.data.image,
      imageAlt: localPost!.data.imageAlt,
      category: localPost!.data.category,
      location: localPost!.data.location,
      author: localPost!.data.author,
    };

const siteUrl = 'https://colorautodetailing.com';

// Format date
const formattedDate = postData.publishDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

// ISO date for structured data
const isoDate = postData.publishDate.toISOString();

// BlogPosting schema
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: postData.title,
  description: postData.description,
  image: postData.image.startsWith('http') ? postData.image : new URL(postData.image, siteUrl).href,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    "@type": "Organization",
    name: postData.author,
    url: siteUrl,
  },
  publisher: {
    "@type": "Organization",
    name: "ColorAuto Detailing",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/images/ColorAuto.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(`/work/${postData.slug}`, siteUrl).href,
  },
  keywords: [postData.category, "Grand Junction", "ColorAuto", postData.location],
};
---

<PublicLayout
  title={`${postData.title} | ColorAuto`}
  description={postData.description}
  keywords={[
    postData.category,
    'Grand Junction',
    'ColorAuto',
    'auto detailing',
    'paint protection',
    postData.location
  ]}
  image={postData.image}
>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'Our Work', href: '/our-work' },
    { label: postData.title }
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <article class="bg-white">
    <!-- Hero Image -->
    <div class="relative h-96 overflow-hidden">
      <img 
        src={postData.image} 
        alt={postData.imageAlt}
        class="w-full h-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
        <div class="max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 bg-blue-600 px-4 py-2 rounded-full text-sm font-semibold mb-4 uppercase shadow-lg backdrop-blur-sm bg-opacity-95 border border-blue-500">
            <span class="w-2 h-2 rounded-full bg-white"></span>
            {postData.category.replace('-', ' ')}
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-3 drop-shadow-lg leading-tight">{postData.title}</h1>
          <div class="flex flex-wrap items-center gap-6 text-sm text-gray-200">
            <div class="flex items-center gap-2">
              <span>📅</span>
              <time>{formattedDate}</time>
            </div>
            <span class="text-gray-400">•</span>
            <div class="flex items-center gap-2">
              <span>📍</span>
              <span>{postData.location}</span>
            </div>
            <span class="text-gray-400">•</span>
            <div class="flex items-center gap-2">
              <span>✍️</span>
              <span>{postData.author}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Article Content -->
    <div class="max-w-4xl mx-auto px-4 py-16">
      <div class="prose prose-lg max-w-none 
        prose-headings:font-bold prose-headings:text-gray-900
        prose-h1:text-4xl prose-h1:mt-12 prose-h1:mb-6 prose-h1:leading-tight
        prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-5 prose-h2:pt-4 prose-h2:border-t prose-h2:border-gray-200
        prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-blue-900
        prose-p:text-gray-700 prose-p:leading-relaxed prose-p:text-base
        prose-ul:my-8 prose-ul:ml-0 prose-li:pl-8 prose-li:my-3 prose-li:text-gray-700
        prose-li:relative prose-li:before:absolute prose-li:before:left-0 prose-li:before:content-['▸'] prose-li:before:text-blue-600 prose-li:before:font-bold
        prose-strong:text-gray-900 prose-strong:font-bold
        prose-em:text-gray-800 prose-em:italic">
        {dbPost ? (
          <>
            <p>{dbPost.projectSummary}</p>

            <h2>Services Performed</h2>
            <ul>
              {dbPost.servicesPerformed.map((service) => (
                <li>{service}</li>
              ))}
            </ul>

            <h2>Installation Process</h2>
            <ol>
              <li><strong>Consultation and inspection</strong>: Confirmed goals and problem areas.</li>
              <li><strong>Surface preparation</strong>: Decontamination and prep for the selected service.</li>
              <li><strong>Professional installation</strong>: Applied {dbPost.materialHighlight} using shop best practices.</li>
              <li><strong>Detail finishing</strong>: Final correction, wipe-down, and finish inspection.</li>
              <li><strong>Delivery walkthrough</strong>: Shared care instructions and maintenance plan.</li>
            </ol>

            <h2>Results</h2>
            <p>This project is now protected and easier to maintain with a cleaner finish and stronger long-term durability.</p>

            <p><strong>Location</strong>: {dbPost.location}<br /><strong>Service Time</strong>: {dbPost.duration}<br /><strong>Product/Material</strong>: {dbPost.materialHighlight}</p>

            <p>Ready for similar results? Learn more about our <a href={dbPost.ctaHref}>{dbPost.ctaLabel}</a> or <a href="/contact">contact us for a quote</a>. Call <strong>{dbPost.phoneNumber}</strong>.</p>
          </>
        ) : (
          Content && <Content />
        )}
      </div>

      {dbPost && dbPost.gallery.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-200">
          <h3 class="text-3xl font-bold mb-8 text-center text-gray-900">Project Gallery</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {dbPost.gallery.map((item) => (
              <div class="group overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition duration-300">
                <img 
                  src={item.src}
                  alt={item.alt}
                  class="w-full h-64 object-cover group-hover:scale-110 transition duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Share & CTA -->
      <div class="mt-16 pt-12 border-t-2 border-gray-200">
        <div class="bg-gradient-to-br from-blue-600 to-blue-800 rounded-2xl p-10 text-white shadow-2xl">
          <h3 class="text-3xl font-bold mb-3">Ready for Similar Results?</h3>
          <p class="text-blue-100 mb-8 text-lg leading-relaxed">Get professional auto detailing, paint protection, and ceramic coating in Grand Junction. Let our experts transform your vehicle.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-blue-50 transition duration-300 text-center shadow-lg hover:shadow-xl transform hover:-translate-y-1">
              Get a Free Quote
            </a>
            <a href="tel:970-628-1505" class="bg-blue-700 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-900 transition duration-300 text-center border-2 border-white hover:shadow-lg transform hover:-translate-y-1">
              Call: 970-628-1505
            </a>
          </div>
        </div>
      </div>

      <!-- Back to Gallery -->
      <div class="mt-12 text-center pb-4">
        <a href="/our-work" class="inline-flex items-center text-blue-600 font-semibold hover:text-blue-700 transition duration-300 group">
          <span class="mr-2 transform group-hover:-translate-x-1 transition duration-300">←</span>
          Back to Our Work
        </a>
      </div>
    </div>
  </article>
</PublicLayout>

<style>
  .prose img {
    border-radius: 0.75rem;
    box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.15);
    margin: 2rem 0;
    transition: all 0.3s ease;
  }
  
  .prose img:hover {
    box-shadow: 0 30px 50px -5px rgba(0, 0, 0, 0.25);
    transform: translateY(-4px);
  }
  
  .prose a {
    color: #2563eb;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
  }
  
  .prose a:hover {
    color: #1d4ed8;
    border-bottom-color: #2563eb;
  }
  
  .prose blockquote {
    border-left: 4px solid #2563eb;
    background-color: #f0f9ff;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #374151;
  }
  
  .prose code {
    background-color: #f3f4f6;
    color: #1f2937;
    padding: 0.5rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }
  
  .prose pre {
    background-color: #111827;
    color: #f3f4f6;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Enhanced list styling */
  .prose ul {
    list-style: none;
  }

  /* Table styling */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .prose table th {
    background-color: #2563eb;
    color: white;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
  }

  .prose table td {
    border: 1px solid #e5e7eb;
    padding: 0.75rem 1rem;
    color: #374151;
  }

  .prose table tr:nth-child(even) {
    background-color: #f9fafb;
  }

  /* Better spacing for hero section */
  article {
    display: flex;
    flex-direction: column;
  }
</style>
